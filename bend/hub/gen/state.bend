import Base

import ../../vendor/json.bend as J

# ---- the enums ----

# what the owner of a task decided (never automatic)
type Life is Data:
  LActive{}
  LStopped{}
  LArchived{}
  LFailed{}

# what an agent's REPL is doing (runtime only)
type Run is Data:
  RDown{}
  RStarting{}
  RIdle{}
  RBusy{}

# the status an agent declares (`sb status`)
type Decl is Data:
  DWorking{}
  DDone{}
  DBlocked{}

# a message's delivery state; any other word reads queued
type MSt is Data:
  Queued{reason: String}
  Delivered{}
  Rejected{error: String}
  Cancelled{}

# when a timer fires: every `ms`, or every day at that minute (local time, the hub's next_daily)
type Sched is Data:
  Every{ms: Nat}
  Daily{min: Nat}

# what an act does: send a held route (its id), try a cross-hub delivery again (its xid), or close a view's approval card he left unanswered (its card id; docs/mcp-apps.md, C5)
type What is Data:
  RouteSend{rid: Nat}
  Retry{xid: Nat}
  CardDue{card: Nat}

# a cross-hub delivery: his words forwarded (input), bise's question (ask), a followed job's end (job_end)
type XKind is Data:
  KInput{}
  KAsk{}
  KJobEnd{}

# an outbox entry: pending, acked by the other hub, settled
type OutSt is Data:
  OPending{}
  OAcked{}
  OSettled{}

# a route: held until its act, sent, cancelled
type RSt is Data:
  RHeld{}
  RSent{}
  RCancelled{}

# ---- the records ----

# a message between two parties of the group (the sender or the recipient may be `user`)
type Msg is Data:
  Msg{id: Nat, thread: Nat, from: String, to: String, reply_to: Maybe<&2, Nat>, expect: Bool, auto: Bool, text: String, created: Nat, plain: Bool, queued: Bool, via: Maybe<&2, String>, parts: String, fwd: Maybe<&2, Nat>, view: Maybe<&2, String>}

# a message, its delivery state and whether it got its (first) reply
type MRec is Data:
  MRec{msg: Msg, st: MSt, settled: Bool}

# what a view's card asks (mcp-apps, C5): the view's agent and call, and its ask (the tool and its arguments as canonical JSON, the shell's): sb-core reads a view's cards by it, never by their place
type ViewAsk is Data:
  ViewAsk{agent: String, call: String, ask: String}

# a card of his inbox; `place`, `pr`: a place's card (ready to merge: its id, PR); `view`: a view's call's card (mcp-apps)
type Card is Data:
  Card{id: Nat, kind: String, agent: String, text: String, for_msg: Maybe<&2, Nat>, created: Nat, place: Maybe<&2, String>, pr: Maybe<&2, Nat>, view: Maybe<&2, ViewAsk>}

# his answer as a card's close journals it: `said`, the option `pick_n`/`pick` ("" none), `via` inbox|thread|page ("" closed without him), the page's question `page`/`block`
type Ans is Data:
  Ans{said: String, pick_n: Maybe<&2, Nat>, pick: String, via: String, page: String, block: String}

# an agent of the group; `dir` its folder (stable on a rename); `follow` the hub that follows it ("" this one)
type Agent is Data:
  Agent{name: String, is_main: Bool, parent: Maybe<&2, String>, life: Life, declared: Maybe<&2, Decl>, aliases: List<&2, String>, files: List<&2, String>, ws: J.Json, dir: String, brief: J.Json, created: Nat, failure: Maybe<&2, String>, note: String, report: J.Json, snap: Maybe<&2, String>, follow: Maybe<&2, String>}

# a card main withdrew he may still answer (gone.bend)
type Item is Data:
  Item{id: Nat, text: String}

# an `sb every` timer: `next` when it is due; `last` when it last woke its agent (0 never); `runs` its last runs, oldest first; `name` what the lists show; `held` set without a name, its set line not written yet
type Timer is Data:
  Timer{id: Nat, agent: String, by: String, text: String, sched: Sched, next: Nat, until: Maybe<&2, Nat>, times: Maybe<&2, Nat>, fired: Nat, page: Maybe<&2, String>, last: Nat, runs: List<&2, Nat>, name: String, held: Bool}

# a timer that ended: when (0: an old line without it) and why
type TimerEnd is Data:
  TimerEnd{t: Timer, at: Nat, why: String}

# an internal step sb-core takes at a time, on the timers' clock
type Act is Data:
  Act{id: Nat, due: Nat, what: What}

# an `sb wake` watch: `spec` what it looks at; `max_text` the wake at its max ("" with `quiet`); `quiet` its max ends it without a wake; `resumes` a pause (True) or an alarm
type Watch is Data:
  Watch{id: Nat, agent: String, spec: J.Json, max_text: String, set_at: Nat, max_at: Nat, quiet: Bool, resumes: Bool}

# a watch that ended: when and why (hit, max, stop, gone)
type WatchEnd is Data:
  WatchEnd{w: Watch, at: Nat, why: String}

# the watches of `sb wake`: live, ended (newest first), the last id given
type Wakes is Data:
  Wakes{live: List<&2, Watch>, ended: List<&2, WatchEnd>, last_id: Nat}

# the agents' wake sources: the timers, the acts on the same clock, the watches
type Tms is Data:
  Tms{live: List<&2, Timer>, ended: List<&2, TimerEnd>, last_id: Nat, acts: List<&2, Act>, next_act: Nat, wk: Wakes}

# an outbox entry: a delivery to another project's hub, until it is settled
type Out is Data:
  Out{xid: Nat, project: String, kind: XKind, msg: Nat, text: String, st: OutSt, tries: Nat, context: String, parts: String}

# a delivery another hub made here, and whether it got its reply
type XIn is Data:
  XIn{hub: String, xid: Nat, msg: Nat, kind: XKind, replied: Bool}

# a message routed to another project, held until its act (`due`), then sent or cancelled
type Route is Data:
  Route{rid: Nat, text: String, via: String, to: String, name: String, due: Nat, act: Nat, why: String, st: RSt, context: String, parts: String}

# the cross-hub state: the outbox, the deliveries in, the routes
type Xs is Data:
  Xs{outbox: List<&2, Out>, next_xid: Nat, xin: List<&2, XIn>, routes: List<&2, Route>, next_rid: Nat}

# the hub's durable state; `paused` since that ms (None runs); `hot`/`old` the messages split (hot ids ascending, old newest first); `gone` the withdrawn cards he may still answer, newest first; `agents`/`arch` the agents split (agents: not archived, in creation order; arch: archived, newest archived first; `order` every name, in creation order)
type St is Data:
  St{agents: List<&2, Agent>, order: List<&2, String>, hot: List<&2, MRec>, cards: List<&2, Card>, notes: List<&2, String>, next_msg: Nat, next_card: Nat, tm: Tms, x: Xs, paused: Maybe<&2, Nat>, old: List<&2, MRec>, gone: List<&2, Item>, arch: List<&2, Agent>}

