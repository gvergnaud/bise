# ---- Item ----

def Item.empty() -> Item:
  Item{0n, ""}

def Item.id(r: Item) -> Nat:
  match r:
    case Item{f0, _}:
      f0

def Item.with_id(r: Item, v: Nat) -> Item:
  match r:
    case Item{_, f1}:
      Item{v, f1}

def Item.over_id(r: Item, g: Nat -> Nat) -> Item:
  match r:
    case Item{f0, f1}:
      Item{g(f0), f1}

def Item.text(r: Item) -> String:
  match r:
    case Item{_, f1}:
      f1

def Item.with_text(r: Item, v: String) -> Item:
  match r:
    case Item{f0, _}:
      Item{f0, v}

def Item.over_text(r: Item, g: String -> String) -> Item:
  match r:
    case Item{f0, f1}:
      Item{f0, g(f1)}

def Item.open(+r: Item) -> Item:
  Item.with_text(Item.with_id(Item.empty(), Item.id(r)), Item.text(r))

