    case FSpawn{+agent, +resume, +crash_note, +wait_load}:
      [J.kv("fx", J.JStr{"spawn"}), J.kv("agent", J.JStr{agent}), J.kv("resume", J.JBool{resume}), J.kv("crash_note", K.jmaybe_s(crash_note)), J.kv("wait_load", J.JBool{wait_load})]
    case FKill{+agent}:
      [J.kv("fx", J.JStr{"kill"}), J.kv("agent", J.JStr{agent})]
    case FWorktreeCreate{+name, +with_changes, +feature}:
      [J.kv("fx", J.JStr{"worktree_create"}), J.kv("name", J.JStr{name}), J.kv("with_changes", J.JBool{with_changes}), J.kv("feature", J.JStr{feature})]
    case FWorktreeDrop{+name, +ws, +dirty, +unpushed}:
      [J.kv("fx", J.JStr{"worktree_drop"}), J.kv("name", J.JStr{name}), J.kv("ws", ws), J.kv("dirty", J.JNum{dirty}), J.kv("unpushed", J.JNum{unpushed})]
    case FWorktreeRestore{+name, +ws, +snapshot}:
      [J.kv("fx", J.JStr{"worktree_restore"}), J.kv("name", J.JStr{name}), J.kv("ws", ws), J.kv("snapshot", K.jmaybe_s(snapshot))]
    case FSay{+agent, +text}:
      [J.kv("fx", J.JStr{"say"}), J.kv("agent", J.JStr{agent}), J.kv("text", J.JStr{text})]
    case FPassthrough{+agent, +line}:
      [J.kv("fx", J.JStr{"passthrough"}), J.kv("agent", J.JStr{agent}), J.kv("line", J.JStr{line})]
    case FInterrupt{+agent}:
      [J.kv("fx", J.JStr{"interrupt"}), J.kv("agent", J.JStr{agent})]
    case FFeed{+agent, +rec}:
      [J.kv("fx", J.JStr{"feed"}), J.kv("agent", J.JStr{agent}), J.kv("rec", rec)]
    case FReply{+token, +body, +message}:
      K.cat([[J.kv("fx", J.JStr{"reply"}), J.kv("token", J.JNum{token}), J.kv("body", body)], K.omit_mbody("message", message)])
    case FSpoke{+token, +ok, +why}:
      K.cat([[J.kv("fx", J.JStr{"spoke"}), J.kv("token", J.JNum{token}), J.kv("ok", J.JBool{ok})], K.omit_s("why", why)])
    case FNotice{+text}:
      [J.kv("fx", J.JStr{"notice"}), J.kv("text", J.JStr{text})]
    case FDeliver{+mode, +agent, +notes, +status, +msgs}:
      [J.kv("fx", J.JStr{"deliver"}), J.kv("mode", J.JStr{mode}), J.kv("agent", J.JStr{agent}), J.kv("notes", J.JArr{K.jstrs(notes)}), J.kv("status", J.JBool{status}), J.kv("msgs", J.JArr{K.jmsgs(msgs)})]
    case FXDeliver{+xid, +project, +kind, +msg, +text, +context, +parts}:
      K.cat([[J.kv("fx", J.JStr{"xdeliver"}), J.kv("xid", J.JNum{xid}), J.kv("project", J.JStr{project}), J.kv("kind", J.JStr{kind}), J.kv("msg", J.JNum{msg}), J.kv("text", J.JStr{text}), J.kv("context", J.JStr{context})], K.omit_s("parts", parts)])
    case FXReply{+hub, +xid, +text}:
      [J.kv("fx", J.JStr{"xreply"}), J.kv("hub", J.JStr{hub}), J.kv("xid", J.JNum{xid}), J.kv("text", J.JStr{text})]
    case FRoute{+rid, +to, +name, +text, +due_ms, +why}:
      [J.kv("fx", J.JStr{"route"}), J.kv("rid", J.JNum{rid}), J.kv("to", J.JStr{to}), J.kv("name", J.JStr{name}), J.kv("text", J.JStr{text}), J.kv("due_ms", J.JNum{due_ms}), J.kv("why", J.JStr{why})]
    case FRouteAsked{+routed}:
      [J.kv("fx", J.JStr{"route_asked"}), J.kv("routed", J.JBool{routed})]
    case FRouteDone{+rid, +state, +to, +xid, +msg}:
      K.cat([[J.kv("fx", J.JStr{"route_done"}), J.kv("rid", J.JNum{rid}), J.kv("state", J.JStr{state}), J.kv("to", J.JStr{to}), J.kv("xid", K.jmaybe_n(xid))], K.omit_mn("msg", msg)])
    case FJobEnd{+agent, +state, +label, +summary, +key, +hub}:
      [J.kv("fx", J.JStr{"job_end"}), J.kv("agent", J.JStr{agent}), J.kv("state", J.JStr{state}), J.kv("label", J.JStr{label}), J.kv("summary", J.JStr{summary}), J.kv("key", J.JNum{key}), J.kv("hub", J.JStr{hub})]
    case FFollowedEnd{+project, +agent, +key, +state, +label, +summary}:
      [J.kv("fx", J.JStr{"followed_end"}), J.kv("project", J.JStr{project}), J.kv("agent", J.JStr{agent}), J.kv("key", J.JNum{key}), J.kv("state", J.JStr{state}), J.kv("label", J.JStr{label}), J.kv("summary", J.JStr{summary})]
    case FCardChoice{+card, +kind, +agent, +place, +pr, +text}:
      [J.kv("fx", J.JStr{"card_choice"}), J.kv("card", J.JNum{card}), J.kv("kind", J.JStr{kind}), J.kv("agent", J.JStr{agent}), J.kv("place", K.jmaybe_s(place)), J.kv("pr", K.jmaybe_n(pr)), J.kv("text", J.JStr{text})]
    case FConfirm{+card, +agent, +text}:
      K.cat([[J.kv("fx", J.JStr{"confirm"})], K.omit_mn("card", card), K.omit_ms("agent", agent), [J.kv("text", J.JStr{text})]])
    case FViewCard{+agent, +call, +card}:
      K.cat([[J.kv("fx", J.JStr{"view_card"}), J.kv("agent", J.JStr{agent}), J.kv("call", J.JStr{call})], K.omit_mn("card", card)])
    case FViewContext{+agent, +call, +kept, +why}:
      K.cat([[J.kv("fx", J.JStr{"view_context"}), J.kv("agent", J.JStr{agent}), J.kv("call", J.JStr{call}), J.kv("kept", J.JBool{kept})], K.omit_s("why", why)])
    case FFocusMain{+name}:
      [J.kv("fx", J.JStr{"focus_main"}), J.kv("name", J.JStr{name})]
    case FUserSent{+text}:
      [J.kv("fx", J.JStr{"user_sent"}), J.kv("text", J.JStr{text})]
    case FRenamed{+old, +new}:
      [J.kv("fx", J.JStr{"renamed"}), J.kv("old", J.JStr{old}), J.kv("new", J.JStr{new})]
    case FRetarget{+from, +to}:
      [J.kv("fx", J.JStr{"retarget"}), J.kv("from", J.JStr{from}), J.kv("to", J.JStr{to})]
    case FNone{}:
      Nil{}

def json(x: Fx) -> J.Json:
  J.obj(kvs(x))

# ---- one encoder per effect (per shape for line and confirm): the list
# sb-core's `out` takes ----

def journal(+ev: J.Json) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FJournal{ev})

def rt(+agent: String, +run: String, +waiting: Bool, +turn_ms: Maybe<&2, Nat>, +turns: Nat) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FRt{agent, run, waiting, turn_ms, turns})

def spawn(+agent: String, +resume: Bool, +crash_note: Maybe<&2, String>, +wait_load: Bool) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FSpawn{agent, resume, crash_note, wait_load})

def kill(+agent: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FKill{agent})

def worktree_create(+name: String, +with_changes: Bool, +feature: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FWorktreeCreate{name, with_changes, feature})

def worktree_drop(+name: String, +ws: J.Json, +dirty: Nat, +unpushed: Nat) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FWorktreeDrop{name, ws, dirty, unpushed})

def worktree_restore(+name: String, +ws: J.Json, +snapshot: Maybe<&2, String>) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FWorktreeRestore{name, ws, snapshot})

def say(+agent: String, +text: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FSay{agent, text})

def passthrough(+agent: String, +line: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FPassthrough{agent, line})

def interrupt(+agent: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FInterrupt{agent})

def feed(+agent: String, +rec: J.Json) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FFeed{agent, rec})

def reply(+token: Nat, +body: J.Json, +message: Maybe<&2, K.Body>) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FReply{token, body, message})

def spoke(+token: Nat, +ok: Bool, +why: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FSpoke{token, ok, why})

def notice(+text: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FNotice{text})

def deliver(+mode: String, +agent: String, +notes: List<&2, String>, +status: Bool, +msgs: List<&2, K.Delivered>) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FDeliver{mode, agent, notes, status, msgs})

def xdeliver(+xid: Nat, +project: String, +kind: String, +msg: Nat, +text: String, +context: String, +parts: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FXDeliver{xid, project, kind, msg, text, context, parts})

def xreply(+hub: String, +xid: Nat, +text: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FXReply{hub, xid, text})

def route(+rid: Nat, +to: String, +name: String, +text: String, +due_ms: Nat, +why: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FRoute{rid, to, name, text, due_ms, why})

def route_asked(+routed: Bool) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FRouteAsked{routed})

def route_done(+rid: Nat, +state: String, +to: String, +xid: Maybe<&2, Nat>, +msg: Maybe<&2, Nat>) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FRouteDone{rid, state, to, xid, msg})

def job_end(+agent: String, +state: String, +label: String, +summary: String, +key: Nat, +hub: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FJobEnd{agent, state, label, summary, key, hub})

def followed_end(+project: String, +agent: String, +key: Nat, +state: String, +label: String, +summary: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FFollowedEnd{project, agent, key, state, label, summary})

def card_choice(+card: Nat, +kind: String, +agent: String, +place: Maybe<&2, String>, +pr: Maybe<&2, Nat>, +text: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FCardChoice{card, kind, agent, place, pr, text})

def confirm_card(+card: Nat, +agent: String, +text: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FConfirm{Some{card}, Some{agent}, text})

def view_card(+agent: String, +call: String, +card: Maybe<&2, Nat>) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FViewCard{agent, call, card})

def view_context(+agent: String, +call: String, +kept: Bool, +why: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FViewContext{agent, call, kept, why})

def focus_main(+name: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FFocusMain{name})

def user_sent(+text: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FUserSent{text})

def renamed(+old: String, +new: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FRenamed{old, new})

def retarget(+from: String, +to: String) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  kvs(FRetarget{from, to})

