import Base

# a line's end: sb-core's blocks join their lines with it
def nl() -> String:
  "\n"

# its first line: the task's id and name
def ctx_head(+id: String, +name: String) -> String:
  String.concat(["## Task `", id, "`: ", name])

# under the head: what this block is (the hub's, not a message to answer)
def ctx_intro() -> String:
  "You now serve this task. What it is, from the hub (not a message to answer):"

# why he wants it
def ctx_why(+why: String) -> String:
  String.concat(["Why: ", why])

# the head of its done-when list
def ctx_done_when() -> String:
  "Done when:"

# a done-when item ticked
def ctx_goal_done(+text: String) -> String:
  String.concat(["- [x] ", text])

# a done-when item still open
def ctx_goal_open(+text: String) -> String:
  String.concat(["- [ ] ", text])

# the head of its agents' newest reports
def ctx_reports() -> String:
  "Its agents' newest reports:"

# one agent's newest report: its kind and summary
def ctx_report(+who: String, +kind: String, +text: String) -> String:
  String.concat(["- ", who, " (", kind, "): ", text])

# a decision of its agents' newest reports
def ctx_decided(+text: String) -> String:
  String.concat(["Decided: ", text])

# the task is paused by him
def ctx_paused() -> String:
  "Paused by the user: its messages wait until he resumes it."

# his words that started it, quoted
def ctx_said(+text: String) -> String:
  String.concat(["He asked: “", text, "”"])

# the head of what waits on him now
def ctx_waits() -> String:
  "Waiting on the user now (never ask him again):"

# one of its open questions or picks: its kind and words
def ctx_wait(+kind: String, +text: String) -> String:
  String.concat(["- ", kind, ": ", text])

# the count of its items waiting on his pages
def ctx_page_waits(+n: String) -> String:
  String.concat(["- on his pages, items waiting: ", n])

# the head of its agents
def ctx_agents() -> String:
  "Its agents:"

# one of its agents and what it says it does now
def ctx_agent(+who: String, +note: String) -> String:
  String.concat(["- ", who, ": ", note])

# one of its agents that says nothing now
def ctx_agent_quiet(+who: String) -> String:
  String.concat(["- ", who])

# the last line: where the rest is
def ctx_more(+id: String) -> String:
  String.concat(["More: sb task show ", id, " --activity"])

# to each of its agents, when he restarted it
def restart_note(+id: String, +name: String) -> String:
  String.concat(["The user restarted task `", id, "` (", name, "): go on with it, or say with sb report why it waits."])

# the same, when main restarted it
def restart_note_main(+id: String, +name: String) -> String:
  String.concat(["main restarted task `", id, "` (", name, "): go on with it, or say with sb report why it waits."])
