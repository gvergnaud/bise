  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IPlaced.of(i)
    case GT{}:
      INone{}

def of.t33(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IRename.of(i)
    case GT{}:
      INone{}

def of.t32(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t31(String.order(t, "placed"), t, i)
    case EQ{}:
      IReady.of(i)
    case GT{}:
      of.t33(String.order(t, "rename"), t, i)

def of.t35(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IRestore.of(i)
    case GT{}:
      INone{}

def of.t37(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IRoute.of(i)
    case GT{}:
      INone{}

def of.t36(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t35(String.order(t, "restore"), t, i)
    case EQ{}:
      IResume.of(i)
    case GT{}:
      of.t37(String.order(t, "route"), t, i)

def of.t34(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t32(String.order(t, "ready"), t, i)
    case EQ{}:
      IReq.of(i)
    case GT{}:
      of.t36(String.order(t, "resume"), t, i)

def of.t39(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IRouteCancel.of(i)
    case GT{}:
      INone{}

def of.t41(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      ISay.of(i)
    case GT{}:
      INone{}

def of.t40(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t39(String.order(t, "route_cancel"), t, i)
    case EQ{}:
      IRouteCorrect.of(i)
    case GT{}:
      of.t41(String.order(t, "say"), t, i)

def of.t43(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      ISteerQueued.of(i)
    case GT{}:
      INone{}

def of.t45(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      ISteered.of(i)
    case GT{}:
      INone{}

def of.t44(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t43(String.order(t, "steer_queued"), t, i)
    case EQ{}:
      ISteerRx.of(i)
    case GT{}:
      of.t45(String.order(t, "steered"), t, i)

def of.t42(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t40(String.order(t, "route_correct"), t, i)
    case EQ{}:
      ISpeaks.of(i)
    case GT{}:
      of.t44(String.order(t, "steer_rx"), t, i)

def of.t38(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t34(String.order(t, "req"), t, i)
    case EQ{}:
      IRouteAsk.of(i)
    case GT{}:
      of.t42(String.order(t, "speaks"), t, i)

def of.t47(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      ITouch.of(i)
    case GT{}:
      INone{}

def of.t49(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IUnplaced.of(i)
    case GT{}:
      INone{}

def of.t48(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t47(String.order(t, "touch"), t, i)
    case EQ{}:
      ITurnStarted.of(i)
    case GT{}:
      of.t49(String.order(t, "unplaced"), t, i)

def of.t51(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IViewConfirmOpen.of(i)
    case GT{}:
      INone{}

def of.t53(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IViewMessage.of(i)
    case GT{}:
      INone{}

def of.t52(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t51(String.order(t, "view_confirm_open"), t, i)
    case EQ{}:
      IViewContext.of(i)
    case GT{}:
      of.t53(String.order(t, "view_message"), t, i)

def of.t50(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t48(String.order(t, "turn_started"), t, i)
    case EQ{}:
      IUnqueue.of(i)
    case GT{}:
      of.t52(String.order(t, "view_context"), t, i)

def of.t55(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IWakeSet.of(i)
    case GT{}:
      INone{}

def of.t57(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IXAck.of(i)
    case GT{}:
      INone{}

def of.t56(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t55(String.order(t, "wake_set"), t, i)
    case EQ{}:
      IWakeStop.of(i)
    case GT{}:
      of.t57(String.order(t, "x_ack"), t, i)

def of.t59(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      INone{}
    case EQ{}:
      IXIn.of(i)
    case GT{}:
      INone{}

def of.t60(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t59(String.order(t, "x_in"), t, i)
    case EQ{}:
      IXReply.of(i)
    case GT{}:
      INone{}

def of.t58(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t56(String.order(t, "wake_stop"), t, i)
    case EQ{}:
      IXFail.of(i)
    case GT{}:
      of.t60(String.order(t, "x_reply"), t, i)

def of.t54(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t50(String.order(t, "unqueue"), t, i)
    case EQ{}:
      IWakeHit.of(i)
    case GT{}:
      of.t58(String.order(t, "x_fail"), t, i)

def of.t46(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t38(String.order(t, "route_ask"), t, i)
    case EQ{}:
      ITick.of(i)
    case GT{}:
      of.t54(String.order(t, "wake_hit"), t, i)

def of.t30(c: Cmp, +t: String, +i: J.Json) -> In:
  match c:
    case LT{}:
      of.t15(String.order(t, "exited"), t, i)
    case EQ{}:
      IPause.of(i)
    case GT{}:
      of.t46(String.order(t, "tick"), t, i)

# the record of a tag (a binary search over the 61 sorted tags); any
# other tag: INone
def of_tag(+t: String, +i: J.Json) -> In:
  of.t30(String.order(t, "pause"), t, i)

# one In from its JSON object
def of(+i: J.Json) -> In:
  of_tag(K.get_s(i, "t"), i)

# ---- encode: the key-value list, in wire order ----

def kvs(x: In) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match x:
    case IReq{+token, +from, +req, +who, +dir, +sock}:
      K.cat([[J.kv("t", J.JStr{"req"}), J.kv("token", J.JNum{token}), J.kv("from", J.JStr{from}), J.kv("req", req), J.kv("who", J.JStr{who})], K.omit_s("dir", dir), K.omit_s("sock", sock)])
    case ISpeaks{+token, +from, +cmd, +who, +dir, +sock}:
      K.cat([[J.kv("t", J.JStr{"speaks"}), J.kv("token", J.JNum{token}), J.kv("from", J.JStr{from}), J.kv("cmd", J.JStr{cmd}), J.kv("who", J.JStr{who})], K.omit_s("dir", dir), K.omit_s("sock", sock)])
    case ITick{}:
      [J.kv("t", J.JStr{"tick"})]
    case IIdle{+agent, +leftover, +held}:
      [J.kv("t", J.JStr{"idle"}), J.kv("agent", J.JStr{agent}), J.kv("leftover", J.JBool{leftover}), J.kv("held", J.JBool{held})]
    case ITurnStarted{+agent}:
      [J.kv("t", J.JStr{"turn_started"}), J.kv("agent", J.JStr{agent})]
    case ISteerRx{+agent}:
      [J.kv("t", J.JStr{"steer_rx"}), J.kv("agent", J.JStr{agent})]
    case ISteered{+agent}:
      [J.kv("t", J.JStr{"steered"}), J.kv("agent", J.JStr{agent})]
    case IAssistant{+agent, +text}:
      [J.kv("t", J.JStr{"assistant"}), J.kv("agent", J.JStr{agent}), J.kv("text", J.JStr{text})]
    case ITouch{+agent, +path}:
      [J.kv("t", J.JStr{"touch"}), J.kv("agent", J.JStr{agent}), J.kv("path", J.JStr{path})]
    case IReady{+agent}:
      [J.kv("t", J.JStr{"ready"}), J.kv("agent", J.JStr{agent})]
    case IExited{+agent, +crashed, +reason, +stalled, +loaded, +row, +stopped}:
      [J.kv("t", J.JStr{"exited"}), J.kv("agent", J.JStr{agent}), J.kv("crashed", J.JBool{crashed}), J.kv("reason", J.JStr{reason}), J.kv("stalled", J.JBool{stalled}), J.kv("loaded", J.JBool{loaded}), J.kv("row", J.JNum{row}), J.kv("stopped", J.JBool{stopped})]
    case IBoot{}:
      [J.kv("t", J.JStr{"boot"})]
    case ISay{+focus, +text, +queued, +parts, +from}:
      K.cat([[J.kv("t", J.JStr{"say"}), J.kv("focus", J.JStr{focus}), J.kv("text", J.JStr{text}), J.kv("queued", J.JBool{queued})], K.omit_s("parts", parts), K.omit_s("from", from)])
    case IRoute{+target, +text, +focus, +queued, +parts}:
      K.cat([[J.kv("t", J.JStr{"route"}), J.kv("target", J.JStr{target}), J.kv("text", J.JStr{text}), J.kv("focus", J.JStr{focus}), J.kv("queued", J.JBool{queued})], K.omit_s("parts", parts)])
    case INew{+base, +brief, +brief_text, +objective, +worktree, +with_changes}:
      [J.kv("t", J.JStr{"new"}), J.kv("base", J.JStr{base}), J.kv("brief", brief), J.kv("brief_text", J.JStr{brief_text}), J.kv("objective", J.JStr{objective}), J.kv("worktree", J.JBool{worktree}), J.kv("with_changes", J.JBool{with_changes})]
    case IDrop{+name, +force}:
      [J.kv("t", J.JStr{"drop"}), J.kv("name", J.JStr{name}), J.kv("force", J.JBool{force})]
    case IRestore{+name}:
      [J.kv("t", J.JStr{"restore"}), J.kv("name", J.JStr{name})]
    case IIsolate{+name}:
      [J.kv("t", J.JStr{"isolate"}), J.kv("name", J.JStr{name})]
    case IPlaced{+name, +ws, +err}:
      [J.kv("t", J.JStr{"placed"}), J.kv("name", J.JStr{name}), J.kv("ws", ws), J.kv("err", J.JStr{err})]
    case IUnplaced{+name, +snapshot, +err}:
      [J.kv("t", J.JStr{"unplaced"}), J.kv("name", J.JStr{name}), J.kv("snapshot", K.jmaybe_s(snapshot)), J.kv("err", J.JStr{err})]
    case IFeatureRetire{+name, +kept, +main}:
      [J.kv("t", J.JStr{"feature_retire"}), J.kv("name", J.JStr{name}), J.kv("kept", J.JStr{kept}), J.kv("main", J.JStr{main})]
    case IRename{+name, +new_name, +valid}:
      [J.kv("t", J.JStr{"rename"}), J.kv("name", J.JStr{name}), J.kv("new_name", J.JStr{new_name}), J.kv("valid", J.JBool{valid})]
    case IAnswer{+card, +text, +parts}:
      K.cat([[J.kv("t", J.JStr{"answer"}), J.kv("card", J.JNum{card}), J.kv("text", J.JStr{text})], K.omit_s("parts", parts)])
    case IInterrupt{+agent}:
      [J.kv("t", J.JStr{"interrupt"}), J.kv("agent", J.JStr{agent})]
    case IUnqueue{+id}:
      [J.kv("t", J.JStr{"unqueue"}), J.kv("id", J.JNum{id})]
    case ISteerQueued{+id}:
      [J.kv("t", J.JStr{"steer_queued"}), J.kv("id", J.JNum{id})]
    case IPassthrough{+focus, +line}:
      [J.kv("t", J.JStr{"passthrough"}), J.kv("focus", J.JStr{focus}), J.kv("line", J.JStr{line})]
    case IFocus{+focus, +note, +direct}:
      [J.kv("t", J.JStr{"focus"}), J.kv("focus", J.JStr{focus}), J.kv("note", K.jmaybe_s(note)), J.kv("direct", J.JStr{direct})]
    case IClose{+card}:
      [J.kv("t", J.JStr{"close"}), J.kv("card", J.JNum{card})]
    case IForceRun{+agent, +run}:
      [J.kv("t", J.JStr{"force_run"}), J.kv("agent", J.JStr{agent}), J.kv("run", J.JStr{run})]
    case IConfirmOpen{+agent, +text}:
      [J.kv("t", J.JStr{"confirm_open"}), J.kv("agent", J.JStr{agent}), J.kv("text", J.JStr{text})]
    case IConfirmClose{+card, +res}:
      [J.kv("t", J.JStr{"confirm_close"}), J.kv("card", J.JNum{card}), J.kv("res", J.JStr{res})]
    case IViewConfirmOpen{+agent, +call, +text, +ask}:
      [J.kv("t", J.JStr{"view_confirm_open"}), J.kv("agent", J.JStr{agent}), J.kv("call", J.JStr{call}), J.kv("text", J.JStr{text}), J.kv("ask", J.JStr{ask})]
    case IViewMessage{+agent, +plugin, +text}:
      [J.kv("t", J.JStr{"view_message"}), J.kv("agent", J.JStr{agent}), J.kv("plugin", J.JStr{plugin}), J.kv("text", J.JStr{text})]
    case IViewContext{+agent, +call, +text, +part}:
      [J.kv("t", J.JStr{"view_context"}), J.kv("agent", J.JStr{agent}), J.kv("call", J.JStr{call}), J.kv("text", J.JStr{text}), J.kv("part", part)]
    case IForge{+to, +text}:
      [J.kv("t", J.JStr{"forge"}), J.kv("to", J.JStr{to}), J.kv("text", J.JStr{text})]
    case IForgeCard{+agent, +text}:
      [J.kv("t", J.JStr{"forge_card"}), J.kv("agent", J.JStr{agent}), J.kv("text", J.JStr{text})]
    case ICardOpen{+kind, +agent, +text, +place, +pr}:
      [J.kv("t", J.JStr{"card_open"}), J.kv("kind", J.JStr{kind}), J.kv("agent", J.JStr{agent}), J.kv("text", J.JStr{text}), J.kv("place", K.jmaybe_s(place)), J.kv("pr", K.jmaybe_n(pr))]
    case IHubMsg{+to, +text}:
      [J.kv("t", J.JStr{"hub_msg"}), J.kv("to", J.JStr{to}), J.kv("text", J.JStr{text})]
    case IClaimsClean{+place, +paths}:
      [J.kv("t", J.JStr{"claims_clean"}), J.kv("place", J.JStr{place}), J.kv("paths", J.JArr{K.jstrs(paths)})]
    case IPageAnswered{+card, +agent, +page, +text, +block}:
      K.cat([[J.kv("t", J.JStr{"page_answered"}), J.kv("card", J.JNum{card}), J.kv("agent", J.JStr{agent}), J.kv("page", J.JStr{page}), J.kv("text", J.JStr{text})], K.omit_s("block", block)])
    case IPageCard{+agents, +kind, +text, +key, +about}:
      K.cat([[J.kv("t", J.JStr{"page_card"}), J.kv("agents", J.JArr{K.jstrs(agents)}), J.kv("kind", J.JStr{kind}), J.kv("text", J.JStr{text}), J.kv("key", J.JStr{key})], K.omit_mj("about", about)])
    case IAnswerPos{+card, +agent, +pos}:
      [J.kv("t", J.JStr{"answer_pos"}), J.kv("card", J.JNum{card}), J.kv("agent", J.JStr{agent}), J.kv("pos", J.JNum{pos})]
    case IEverySet{+agent, +by, +text, +next_ms, +name, +every_ms, +daily_min, +until_ms, +times, +page}:
      K.cat([[J.kv("t", J.JStr{"every_set"}), J.kv("agent", J.JStr{agent}), J.kv("by", J.JStr{by}), J.kv("text", J.JStr{text}), J.kv("next_ms", J.JNum{next_ms})], K.omit_s("name", name), K.omit_mn("every_ms", every_ms), K.omit_mn("daily_min", daily_min), K.omit_mn("until_ms", until_ms), K.omit_mn("times", times), K.omit_ms("page", page)])
    case IEveryStop{+id, +why, +wake}:
      [J.kv("t", J.JStr{"every_stop"}), J.kv("id", J.JNum{id}), J.kv("why", J.JStr{why}), J.kv("wake", J.JStr{wake})]
    case IEveryRun{+id, +text}:
      [J.kv("t", J.JStr{"every_run"}), J.kv("id", J.JNum{id}), J.kv("text", J.JStr{text})]
    case IEveryName{+id, +name}:
      [J.kv("t", J.JStr{"every_name"}), J.kv("id", J.JNum{id}), J.kv("name", J.JStr{name})]
    case IXIn{+token, +hub, +xid, +kind, +text, +name, +parts}:
      K.cat([[J.kv("t", J.JStr{"x_in"}), J.kv("token", J.JNum{token}), J.kv("hub", J.JStr{hub}), J.kv("xid", J.JNum{xid}), J.kv("kind", J.JStr{kind}), J.kv("text", J.JStr{text}), J.kv("name", J.JStr{name})], K.omit_s("parts", parts)])
    case IXAck{+xid}:
      [J.kv("t", J.JStr{"x_ack"}), J.kv("xid", J.JNum{xid})]
    case IXFail{+xid}:
      [J.kv("t", J.JStr{"x_fail"}), J.kv("xid", J.JNum{xid})]
    case IXReply{+xid, +name, +text}:
      [J.kv("t", J.JStr{"x_reply"}), J.kv("xid", J.JNum{xid}), J.kv("name", J.JStr{name}), J.kv("text", J.JStr{text})]
    case IRouteAsk{+focus, +text, +via, +queued, +context, +parts, +projects}:
      K.cat([[J.kv("t", J.JStr{"route_ask"}), J.kv("focus", J.JStr{focus}), J.kv("text", J.JStr{text}), J.kv("via", J.JStr{via}), J.kv("queued", J.JBool{queued}), J.kv("context", J.JStr{context})], K.omit_s("parts", parts), [J.kv("projects", J.JArr{projects})]])
    case IRouteCorrect{+rid, +to, +name}:
      [J.kv("t", J.JStr{"route_correct"}), J.kv("rid", J.JNum{rid}), J.kv("to", J.JStr{to}), J.kv("name", J.JStr{name})]
    case IRouteCancel{+rid}:
      [J.kv("t", J.JStr{"route_cancel"}), J.kv("rid", J.JNum{rid})]
    case IFollow{+agent, +on}:
      [J.kv("t", J.JStr{"follow"}), J.kv("agent", J.JStr{agent}), J.kv("on", J.JBool{on})]
    case IWakeSet{+agent, +spec, +max_text, +max_ms, +quiet, +then}:
      K.cat([[J.kv("t", J.JStr{"wake_set"}), J.kv("agent", J.JStr{agent}), J.kv("spec", spec), J.kv("max_text", J.JStr{max_text}), J.kv("max_ms", J.JNum{max_ms}), J.kv("quiet", J.JBool{quiet})], K.omit_mb("then", then)])
    case IWakeStop{+id, +why, +tell}:
      K.cat([[J.kv("t", J.JStr{"wake_stop"}), J.kv("id", J.JNum{id}), J.kv("why", J.JStr{why})], K.omit_s("tell", tell)])
    case IWakeHit{+id, +text}:
      [J.kv("t", J.JStr{"wake_hit"}), J.kv("id", J.JNum{id}), J.kv("text", J.JStr{text})]
    case IPause{}:
      [J.kv("t", J.JStr{"pause"})]
    case IResume{}:
      [J.kv("t", J.JStr{"resume"})]
    case INone{}:
      Nil{}

def json(x: In) -> J.Json:
  J.obj(kvs(x))

