# ---- Act, its journal shape: id, due, what ----

def Act.journal_kvs(r: S.Act) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Act{+id, +due, +what}:
      [J.kv("id", J.JNum{id}), J.kv("due", J.JNum{due}), J.kv("what", What.journal_json(what))]

def Act.journal_json(r: S.Act) -> J.Json:
  J.obj(Act.journal_kvs(r))

def Act.journal_of(+j: J.Json) -> S.Act:
  S.Act{rd.n(J.get(j, "id")), rd.n(J.get(j, "due")), What.journal_of(rd.j(J.get(j, "what")))}

law Act.journal.id:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "id")) == id : Nat}

def Act.journal.id(id, due, what):
  {==}

law Act.journal.due:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "due")) == due : Nat}

def Act.journal.due(id, due, what):
  {==}

law Act.journal.what:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {What.journal_of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what"))) == what : S.What}

def Act.journal.what(id, due, what):
  What.journal_round(what)

# the fields it carries come back (the others at their default)
law Act.journal_round_by_fields:
  for +id: Nat
  for +due: Nat
  for +what: S.What
  {Act.journal_of(Act.journal_json(S.Act{id, due, what})) == S.Act{id, due, what} : S.Act}

def Act.journal_round_by_fields(id, due, what):
  %Equal.sym(Nat, rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "id")), id, Act.journal.id(id, due, what)) : {S.Act{_, rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "due")), What.journal_of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what")))} == S.Act{id, due, what} : S.Act}
  %Equal.sym(Nat, rd.n(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "due")), due, Act.journal.due(id, due, what)) : {S.Act{id, _, What.journal_of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what")))} == S.Act{id, due, what} : S.Act}
  %Equal.sym(S.What, What.journal_of(rd.j(J.get(J.obj(Act.journal_kvs(S.Act{id, due, what})), "what"))), what, Act.journal.what(id, due, what)) : {S.Act{id, due, _} == S.Act{id, due, what} : S.Act}
  {==}

law Act.journal_round:
  for x: S.Act
  {Act.journal_of(Act.journal_json(x)) == x : S.Act}

def Act.journal_round(x):
  match x:
    case S.Act{id, due, what}:
      Act.journal_round_by_fields(id, due, what)

# ---- a list of Act, each in its journal shape ----

def Act.journal_list(xs: List<&2, S.Act>) -> List<&2, J.Json>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Act.journal_json(h) <> Act.journal_list(t)

def Act.journal_list_of.go(xs: List<&2, J.Json>) -> List<&2, S.Act>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Act.journal_of(h) <> Act.journal_list_of.go(t)

# an array's items; anything else: none
def Act.journal_list_of(+j: J.Json) -> List<&2, S.Act>:
  match j:
    case J.JArr{+xs}:
      Act.journal_list_of.go(xs)
    case _:
      Nil{}

law Act.journal_list_round.go:
  for xs: List<&2, S.Act>
  {Act.journal_list_of.go(Act.journal_list(xs)) == xs : List<&2, S.Act>}

def Act.journal_list_round.go(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %Act.journal_round(h) : {Act.journal_of(Act.journal_json(h)) <> Act.journal_list_of.go(Act.journal_list(t)) == _ <> t : List<&2, S.Act>}
      %Act.journal_list_round.go(t) : {Act.journal_of(Act.journal_json(h)) <> Act.journal_list_of.go(Act.journal_list(t)) == Act.journal_of(Act.journal_json(h)) <> _ : List<&2, S.Act>}
      {==}

law Act.journal_list_round:
  for xs: List<&2, S.Act>
  {Act.journal_list_of(J.JArr{Act.journal_list(xs)}) == xs : List<&2, S.Act>}

def Act.journal_list_round(xs):
  Act.journal_list_round.go(xs)

# ---- Watch, its journal shape: id, agent, spec, max_text, set_at, max_at, quiet, resumes, works ----

def Watch.journal_kvs(r: S.Watch) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Watch{+id, +agent, +spec, +max_text, +set_at, +max_at, +quiet, +resumes, +works}:
      K.cat([[J.kv("id", J.JNum{id}), J.kv("agent", J.JStr{agent}), J.kv("spec", spec), J.kv("max_text", J.JStr{max_text}), J.kv("set_at", J.JNum{set_at}), J.kv("max_at", J.JNum{max_at}), J.kv("quiet", J.JBool{quiet}), J.kv("resumes", J.JBool{resumes})], K.omit_ss("works", works)])

def Watch.journal_json(r: S.Watch) -> J.Json:
  J.obj(Watch.journal_kvs(r))

def Watch.journal_of(+j: J.Json) -> S.Watch:
  S.Watch{rd.n(J.get(j, "id")), rd.s(J.get(j, "agent")), rd.j(J.get(j, "spec")), rd.s(J.get(j, "max_text")), rd.n(J.get(j, "set_at")), rd.n(J.get(j, "max_at")), rd.b(J.get(j, "quiet")), SH.watch_resumes(J.get(j, "resumes"), J.get(j, "spec")), rd.ss(J.get(j, "works"))}

