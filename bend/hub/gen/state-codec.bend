      %skip_mn("pick_n", pick_n, [K.omit_s("pick", SCon{pick_h, pick_t}), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "pick", {==}) : {rd.s(_) == SCon{pick_h, pick_t} : String}
