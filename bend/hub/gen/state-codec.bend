law XIn.journal_round:
  for x: S.XIn
  {XIn.journal_of(XIn.journal_json(x)) == x : S.XIn}

def XIn.journal_round(x):
  match x:
    case S.XIn{hub, xid, msg, kind, replied}:
      XIn.journal_round_by_fields(hub, xid, msg, kind, replied)

# ---- a list of XIn, each in its journal shape ----

def XIn.journal_list(xs: List<&2, S.XIn>) -> List<&2, J.Json>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      XIn.journal_json(h) <> XIn.journal_list(t)

def XIn.journal_list_of.go(xs: List<&2, J.Json>) -> List<&2, S.XIn>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      XIn.journal_of(h) <> XIn.journal_list_of.go(t)

# an array's items; anything else: none
def XIn.journal_list_of(+j: J.Json) -> List<&2, S.XIn>:
  match j:
    case J.JArr{+xs}:
      XIn.journal_list_of.go(xs)
    case _:
      Nil{}

law XIn.journal_list_round.go:
  for xs: List<&2, S.XIn>
  {XIn.journal_list_of.go(XIn.journal_list(xs)) == xs : List<&2, S.XIn>}

def XIn.journal_list_round.go(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %XIn.journal_round(h) : {XIn.journal_of(XIn.journal_json(h)) <> XIn.journal_list_of.go(XIn.journal_list(t)) == _ <> t : List<&2, S.XIn>}
      %XIn.journal_list_round.go(t) : {XIn.journal_of(XIn.journal_json(h)) <> XIn.journal_list_of.go(XIn.journal_list(t)) == XIn.journal_of(XIn.journal_json(h)) <> _ : List<&2, S.XIn>}
      {==}

law XIn.journal_list_round:
  for xs: List<&2, S.XIn>
  {XIn.journal_list_of(J.JArr{XIn.journal_list(xs)}) == xs : List<&2, S.XIn>}

def XIn.journal_list_round(xs):
  XIn.journal_list_round.go(xs)

# ---- Route, its journal shape: rid, text, via, to, name, due_ms, act, why, state, context, parts ----

def Route.journal_kvs(r: S.Route) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Route{+rid, +text, +via, +to, +name, +due, +act, +why, +st, +context, +parts}:
      K.cat([[J.kv("rid", J.JNum{rid}), J.kv("text", J.JStr{text}), J.kv("via", J.JStr{via}), J.kv("to", J.JStr{to}), J.kv("name", J.JStr{name}), J.kv("due_ms", J.JNum{due}), J.kv("act", J.JNum{act}), J.kv("why", J.JStr{why}), J.kv("state", J.JStr{RSt.word(st)}), J.kv("context", J.JStr{context})], K.omit_s("parts", parts)])

def Route.journal_json(r: S.Route) -> J.Json:
  J.obj(Route.journal_kvs(r))

def Route.journal_of(+j: J.Json) -> S.Route:
  S.Route{rd.n(J.get(j, "rid")), rd.s(J.get(j, "text")), rd.s(J.get(j, "via")), rd.s(J.get(j, "to")), rd.s(J.get(j, "name")), rd.n(J.get(j, "due_ms")), rd.n(J.get(j, "act")), rd.s(J.get(j, "why")), RSt.of_word(rd.s(J.get(j, "state"))), rd.s(J.get(j, "context")), rd.s(J.get(j, "parts"))}

law Route.journal.rid:
  for +rid: Nat
  for +text: String
  for +via: String
  for +to: String
  for +name: String
  for +due: Nat
  for +act: Nat
  for +why: String
  for +st: S.RSt
  for +context: String
  for +parts: String
  {rd.n(J.get(J.obj(Route.journal_kvs(S.Route{rid, text, via, to, name, due, act, why, st, context, parts})), "rid")) == rid : Nat}

