  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
  {rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block")) == block : String}

def Ans.journal.block(said, pick_n, pick, via, page, block):
  match block:
    case SNil{}:
      %skip_s("said", said, [K.omit_mn("pick_n", pick_n), K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", SNil{})], "block", {==}) : {rd.s(_) == SNil{} : String}
      %skip_mn("pick_n", pick_n, [K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", SNil{})], "block", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("pick", pick, [K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", SNil{})], "block", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("via", via, [K.omit_s("page", page), K.omit_s("block", SNil{})], "block", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("page", page, [K.omit_s("block", SNil{})], "block", {==}) : {rd.s(_) == SNil{} : String}
      {==}
    case SCon{block_h, block_t}:
      %skip_s("said", said, [K.omit_mn("pick_n", pick_n), K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", SCon{block_h, block_t})], "block", {==}) : {rd.s(_) == SCon{block_h, block_t} : String}
      %skip_mn("pick_n", pick_n, [K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", SCon{block_h, block_t})], "block", {==}) : {rd.s(_) == SCon{block_h, block_t} : String}
      %skip_s("pick", pick, [K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", SCon{block_h, block_t})], "block", {==}) : {rd.s(_) == SCon{block_h, block_t} : String}
      %skip_s("via", via, [K.omit_s("page", page), K.omit_s("block", SCon{block_h, block_t})], "block", {==}) : {rd.s(_) == SCon{block_h, block_t} : String}
      %skip_s("page", page, [K.omit_s("block", SCon{block_h, block_t})], "block", {==}) : {rd.s(_) == SCon{block_h, block_t} : String}
      {==}

# the fields it carries come back (the others at their default)
law Ans.journal_round_by_fields:
  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
  {Ans.journal_of(Ans.journal_json(S.Ans{said, pick_n, pick, via, page, block})) == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}

def Ans.journal_round_by_fields(said, pick_n, pick, via, page, block):
  %Equal.sym(String, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "said")), said, Ans.journal.said(said, pick_n, pick, via, page, block)) : {S.Ans{_, K.opt_n(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick_n")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "via")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "page")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block"))} == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}
  %Equal.sym(Maybe<&2, Nat>, K.opt_n(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick_n")), pick_n, Ans.journal.pick_n(said, pick_n, pick, via, page, block)) : {S.Ans{said, _, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "via")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "page")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block"))} == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}
  %Equal.sym(String, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick")), pick, Ans.journal.pick(said, pick_n, pick, via, page, block)) : {S.Ans{said, pick_n, _, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "via")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "page")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block"))} == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}
  %Equal.sym(String, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "via")), via, Ans.journal.via(said, pick_n, pick, via, page, block)) : {S.Ans{said, pick_n, pick, _, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "page")), rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block"))} == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}
  %Equal.sym(String, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "page")), page, Ans.journal.page(said, pick_n, pick, via, page, block)) : {S.Ans{said, pick_n, pick, via, _, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block"))} == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}
  %Equal.sym(String, rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "block")), block, Ans.journal.block(said, pick_n, pick, via, page, block)) : {S.Ans{said, pick_n, pick, via, page, _} == S.Ans{said, pick_n, pick, via, page, block} : S.Ans}
  {==}

law Ans.journal_round:
  for x: S.Ans
  {Ans.journal_of(Ans.journal_json(x)) == x : S.Ans}

def Ans.journal_round(x):
  match x:
    case S.Ans{said, pick_n, pick, via, page, block}:
      Ans.journal_round_by_fields(said, pick_n, pick, via, page, block)

# ---- Agent, its photo shape: name, is_main, parent, life, declared, aliases, files, ws, dir, brief, created, failure, note, report, snap, follow ----

def Agent.photo_kvs(r: S.Agent) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Agent{+name, +is_main, +parent, +life, +declared, +aliases, +files, +ws, +dir, +brief, +created, +failure, +note, +report, +snap, +follow}:
      [J.kv("name", J.JStr{name}), J.kv("is_main", J.JBool{is_main}), J.kv("parent", K.jmaybe_s(parent)), J.kv("life", J.JStr{Life.word(life)}), J.kv("declared", Decl.opt_json(declared)), J.kv("aliases", J.JArr{K.jstrs(aliases)}), J.kv("files", J.JArr{K.jstrs(files)}), J.kv("ws", ws), J.kv("dir", J.JStr{dir}), J.kv("brief", brief), J.kv("created", J.JNum{created}), J.kv("failure", K.jmaybe_s(failure)), J.kv("note", J.JStr{note}), J.kv("report", report), J.kv("snap", K.jmaybe_s(snap)), J.kv("follow", K.jmaybe_s(follow))]

def Agent.photo_json(r: S.Agent) -> J.Json:
  J.obj(Agent.photo_kvs(r))

def Agent.photo_of(+j: J.Json) -> S.Agent:
  S.Agent{rd.s(J.get(j, "name")), rd.b(J.get(j, "is_main")), K.opt_s(J.get(j, "parent")), Life.of_word(rd.s(J.get(j, "life"))), Decl.opt_of(J.get(j, "declared")), rd.ss(J.get(j, "aliases")), rd.ss(J.get(j, "files")), rd.j(J.get(j, "ws")), rd.s(J.get(j, "dir")), rd.j(J.get(j, "brief")), rd.n(J.get(j, "created")), K.opt_s(J.get(j, "failure")), rd.s(J.get(j, "note")), rd.j(J.get(j, "report")), K.opt_s(J.get(j, "snap")), K.opt_s(J.get(j, "follow"))}

