  %Equal.sym(Nat, rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "tries")), tries, Out.journal.tries(xid, project, kind, msg, text, st, tries, context, parts)) : {S.Out{xid, project, kind, msg, text, st, _, rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "context")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "parts"))} == S.Out{xid, project, kind, msg, text, st, tries, context, parts} : S.Out}
  %Equal.sym(String, rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "context")), context, Out.journal.context(xid, project, kind, msg, text, st, tries, context, parts)) : {S.Out{xid, project, kind, msg, text, st, tries, _, rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "parts"))} == S.Out{xid, project, kind, msg, text, st, tries, context, parts} : S.Out}
