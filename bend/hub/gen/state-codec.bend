# ---- St, its photo shape: agents, order, hot, cards, notes, next_msg, next_card, tm, x, paused, old, gone, arch, works, tombs ----

def St.photo_kvs(r: S.St) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.St{+agents, +order, +hot, +cards, +notes, +next_msg, +next_card, +tm, +x, +paused, +old, +gone, +arch, +works, +tombs}:
      [J.kv("agents", J.JArr{Agent.photo_list(agents)}), J.kv("order", J.JArr{K.jstrs(order)}), J.kv("hot", J.JArr{MRec.photo_list(hot)}), J.kv("cards", J.JArr{Card.journal_list(cards)}), J.kv("notes", J.JArr{K.jstrs(notes)}), J.kv("next_msg", J.JNum{next_msg}), J.kv("next_card", J.JNum{next_card}), J.kv("tm", Tms.photo_json(tm)), J.kv("x", Xs.photo_json(x)), J.kv("paused", K.jmaybe_n(paused)), J.kv("old", J.JArr{MRec.photo_list(old)}), J.kv("gone", J.JArr{Item.photo_list(gone)}), J.kv("arch", J.JArr{Agent.photo_list(arch)}), J.kv("works", J.JArr{Work.journal_list(works)}), J.kv("tombs", J.JArr{Tomb.journal_list(tombs)})]

def St.photo_json(r: S.St) -> J.Json:
