def Fin.journal_mjson(m: Maybe<&2, S.Fin>) -> Maybe<&2, J.Json>:
  match m:
    case None{}:
      None{}
    case Some{+x}:
      Some{Fin.journal_json(x)}

def Fin.journal_mof(m: Maybe<&2, J.Json>) -> Maybe<&2, S.Fin>:
  match m:
    case None{}:
      None{}
    case Some{+j}:
      Some{Fin.journal_of(j)}

