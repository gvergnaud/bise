def Out.journal_round_by_fields(xid, project, kind, msg, text, st, tries, context, parts):
  %Equal.sym(Nat, rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "xid")), xid, Out.journal.xid(xid, project, kind, msg, text, st, tries, context, parts)) : {S.Out{_, rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "project")), XKind.of_word(rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "kind"))), rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "msg")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "text")), OutSt.of_word(rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "state"))), rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "tries")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "context")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "parts"))} == S.Out{xid, project, kind, msg, text, st, tries, context, parts} : S.Out}
  %Equal.sym(String, rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "project")), project, Out.journal.project(xid, project, kind, msg, text, st, tries, context, parts)) : {S.Out{xid, _, XKind.of_word(rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "kind"))), rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "msg")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "text")), OutSt.of_word(rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "state"))), rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "tries")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "context")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "parts"))} == S.Out{xid, project, kind, msg, text, st, tries, context, parts} : S.Out}
