law St.photo_round:
  for x: S.St
  {St.photo_of(St.photo_json(x)) == x : S.St}

def St.photo_round(x):
  match x:
    case S.St{agents, order, hot, cards, notes, next_msg, next_card, tm, x, paused, old, gone, arch, works, tombs}:
      St.photo_round_by_fields(agents, order, hot, cards, notes, next_msg, next_card, tm, x, paused, old, gone, arch, works, tombs)

# ---- St in slices, the photo in lines: agents, order, hot, cards, notes, next_msg, next_card, tm, x, paused, old, gone, arch, works, tombs ----

# what k leaves after xs's first items (0n once they spend it)
def St.slice.left(-A: Data, xs: List<&2, A>, k: Nat) -> Nat:
  match xs:
    case Nil{}:
      k
    case Con{h, t}:
      match k:
        case 0n:
          0n
        case 1n+p:
          St.slice.left(A, t, p)

def St.slice.take_drop(-A: Data, +xs: List<&2, A>, +k: Nat)
    -> {List.append(&2, A, List.take(&2, A, xs, k), List.drop(&2, A, xs, k)) == xs : List<&2, A>}:
  match xs k:
    case Nil{} _:
      {==}
    case Con{h, t} 0n:
      {==}
    case Con{h, t} 1n+p:
      Equal.cong(List<&2, A>, List<&2, A>, y => h <> y, List.append(&2, A, List.take(&2, A, t, p), List.drop(&2, A, t, p)), t, St.slice.take_drop(A, t, p))

def St.slice.none(-A: Data, xs: List<&2, A>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      False{}

# the first k records of st's lists, in field order; st's scalars
def St.slice_take(+k: Nat, st: S.St) -> S.St:
  match st:
    case S.St{+f0, +f1, +f2, +f3, +f4, +f5, +f6, +f7, +f8, +f9, +f10, +f11, +f12, +f13, +f14}:
      S.St{List.take(&2, S.Agent, f0, k), List.take(&2, String, f1, St.slice.left(S.Agent, f0, k)), List.take(&2, S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))), List.take(&2, S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k)))), List.take(&2, String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))), f5, f6, f7, f8, f9, List.take(&2, S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k)))))), List.take(&2, S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))))), List.take(&2, S.Agent, f12, St.slice.left(S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k)))))))), List.take(&2, S.Work, f13, St.slice.left(S.Agent, f12, St.slice.left(S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))))))), List.take(&2, S.Tomb, f14, St.slice.left(S.Work, f13, St.slice.left(S.Agent, f12, St.slice.left(S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))))))))}

# st's lists past their first k records; St.empty()'s scalars
def St.slice_drop(+k: Nat, st: S.St) -> S.St:
  match st:
    case S.St{+f0, +f1, +f2, +f3, +f4, +f5, +f6, +f7, +f8, +f9, +f10, +f11, +f12, +f13, +f14}:
      S.St{List.drop(&2, S.Agent, f0, k), List.drop(&2, String, f1, St.slice.left(S.Agent, f0, k)), List.drop(&2, S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))), List.drop(&2, S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k)))), List.drop(&2, String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))), 1n, 1n, S.Tms.empty(), S.Xs.empty(), None{}, List.drop(&2, S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k)))))), List.drop(&2, S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))))), List.drop(&2, S.Agent, f12, St.slice.left(S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k)))))))), List.drop(&2, S.Work, f13, St.slice.left(S.Agent, f12, St.slice.left(S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))))))), List.drop(&2, S.Tomb, f14, St.slice.left(S.Work, f13, St.slice.left(S.Agent, f12, St.slice.left(S.Item, f11, St.slice.left(S.MRec, f10, St.slice.left(String, f4, St.slice.left(S.Card, f3, St.slice.left(S.MRec, f2, St.slice.left(String, f1, St.slice.left(S.Agent, f0, k))))))))))}

# a's records before b's; a's scalars
def St.slice_join(a: S.St, b: S.St) -> S.St:
  match a b:
    case S.St{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14} S.St{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14}:
      S.St{List.append(&2, S.Agent, a0, b0), List.append(&2, String, a1, b1), List.append(&2, S.MRec, a2, b2), List.append(&2, S.Card, a3, b3), List.append(&2, String, a4, b4), a5, a6, a7, a8, a9, List.append(&2, S.MRec, a10, b10), List.append(&2, S.Item, a11, b11), List.append(&2, S.Agent, a12, b12), List.append(&2, S.Work, a13, b13), List.append(&2, S.Tomb, a14, b14)}

# no record left in st's lists
def St.slice_none(st: S.St) -> Bool:
  match st:
    case S.St{+f0, +f1, +f2, +f3, +f4, +f5, +f6, +f7, +f8, +f9, +f10, +f11, +f12, +f13, +f14}:
      St.slice.none(S.Agent, f0) && St.slice.none(String, f1) && St.slice.none(S.MRec, f2) && St.slice.none(S.Card, f3) && St.slice.none(String, f4) && St.slice.none(S.MRec, f10) && St.slice.none(S.Item, f11) && St.slice.none(S.Agent, f12) && St.slice.none(S.Work, f13) && St.slice.none(S.Tomb, f14)

law St.slice_round:
  for +k: Nat
  for +st: S.St
  {St.slice_join(St.slice_take(k, st), St.slice_drop(k, st)) == st : S.St}

