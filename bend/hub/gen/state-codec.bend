law Card.journal_round:
  for x: S.Card
  {Card.journal_of(Card.journal_json(x)) == x : S.Card}

def Card.journal_round(x):
  match x:
    case S.Card{id, kind, agent, text, for_msg, created, place, pr, view}:
      Card.journal_round_by_fields(id, kind, agent, text, for_msg, created, place, pr, view)

# ---- a list of Card, each in its journal shape ----

def Card.journal_list(xs: List<&2, S.Card>) -> List<&2, J.Json>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Card.journal_json(h) <> Card.journal_list(t)

def Card.journal_list_of.go(xs: List<&2, J.Json>) -> List<&2, S.Card>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Card.journal_of(h) <> Card.journal_list_of.go(t)

# an array's items; anything else: none
def Card.journal_list_of(+j: J.Json) -> List<&2, S.Card>:
  match j:
    case J.JArr{+xs}:
      Card.journal_list_of.go(xs)
    case _:
      Nil{}

law Card.journal_list_round.go:
  for xs: List<&2, S.Card>
  {Card.journal_list_of.go(Card.journal_list(xs)) == xs : List<&2, S.Card>}

def Card.journal_list_round.go(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %Card.journal_round(h) : {Card.journal_of(Card.journal_json(h)) <> Card.journal_list_of.go(Card.journal_list(t)) == _ <> t : List<&2, S.Card>}
      %Card.journal_list_round.go(t) : {Card.journal_of(Card.journal_json(h)) <> Card.journal_list_of.go(Card.journal_list(t)) == Card.journal_of(Card.journal_json(h)) <> _ : List<&2, S.Card>}
      {==}

law Card.journal_list_round:
  for xs: List<&2, S.Card>
  {Card.journal_list_of(J.JArr{Card.journal_list(xs)}) == xs : List<&2, S.Card>}

def Card.journal_list_round(xs):
  Card.journal_list_round.go(xs)

# ---- Ans, its journal shape: said, pick_n, pick, via, page, block ----

def Ans.journal_kvs(r: S.Ans) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Ans{+said, +pick_n, +pick, +via, +page, +block}:
      K.cat([K.omit_s("said", said), K.omit_mn("pick_n", pick_n), K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)])

def Ans.journal_json(r: S.Ans) -> J.Json:
  J.obj(Ans.journal_kvs(r))

def Ans.journal_of(+j: J.Json) -> S.Ans:
  S.Ans{rd.s(J.get(j, "said")), K.opt_n(J.get(j, "pick_n")), rd.s(J.get(j, "pick")), rd.s(J.get(j, "via")), rd.s(J.get(j, "page")), rd.s(J.get(j, "block"))}

law Ans.journal.said:
  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
  {rd.s(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "said")) == said : String}

def Ans.journal.said(said, pick_n, pick, via, page, block):
  match said:
    case SNil{}:
      %skip_mn("pick_n", pick_n, [K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("pick", pick, [K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("via", via, [K.omit_s("page", page), K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("page", page, [K.omit_s("block", block)], "said", {==}) : {rd.s(_) == SNil{} : String}
      %skip_s("block", block, [], "said", {==}) : {rd.s(_) == SNil{} : String}
      {==}
    case SCon{said_h, said_t}:
      {==}

law Ans.journal.pick_n:
  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
  {K.opt_n(J.get(J.obj(Ans.journal_kvs(S.Ans{said, pick_n, pick, via, page, block})), "pick_n")) == pick_n : Maybe<&2, Nat>}

def Ans.journal.pick_n(said, pick_n, pick, via, page, block):
  match pick_n:
    case None{}:
      %skip_s("said", said, [K.omit_mn("pick_n", None{}), K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "pick_n", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
      %skip_s("pick", pick, [K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "pick_n", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
      %skip_s("via", via, [K.omit_s("page", page), K.omit_s("block", block)], "pick_n", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
      %skip_s("page", page, [K.omit_s("block", block)], "pick_n", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
      %skip_s("block", block, [], "pick_n", {==}) : {K.opt_n(_) == None{} : Maybe<&2, Nat>}
      {==}
    case Some{pick_n_x}:
      %skip_s("said", said, [K.omit_mn("pick_n", Some{pick_n_x}), K.omit_s("pick", pick), K.omit_s("via", via), K.omit_s("page", page), K.omit_s("block", block)], "pick_n", {==}) : {K.opt_n(_) == Some{pick_n_x} : Maybe<&2, Nat>}
      {==}

law Ans.journal.pick:
  for +said: String
  for +pick_n: Maybe<&2, Nat>
  for +pick: String
  for +via: String
  for +page: String
  for +block: String
