def Tms.photo_round(x):
  match x:
    case S.Tms{live, ended, last_id, acts, next_act, wk}:
      Tms.photo_round_by_fields(live, ended, last_id, acts, next_act, wk)

# ---- Out, its journal shape: xid, project, kind, msg, text, state, tries, context, parts ----

def Out.journal_kvs(r: S.Out) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Out{+xid, +project, +kind, +msg, +text, +st, +tries, +context, +parts}:
      K.cat([[J.kv("xid", J.JNum{xid}), J.kv("project", J.JStr{project}), J.kv("kind", J.JStr{XKind.word(kind)}), J.kv("msg", J.JNum{msg}), J.kv("text", J.JStr{text}), J.kv("state", J.JStr{OutSt.word(st)}), J.kv("tries", J.JNum{tries}), J.kv("context", J.JStr{context})], K.omit_s("parts", parts)])

def Out.journal_json(r: S.Out) -> J.Json:
  J.obj(Out.journal_kvs(r))

def Out.journal_of(+j: J.Json) -> S.Out:
  S.Out{rd.n(J.get(j, "xid")), rd.s(J.get(j, "project")), XKind.of_word(rd.s(J.get(j, "kind"))), rd.n(J.get(j, "msg")), rd.s(J.get(j, "text")), OutSt.of_word(rd.s(J.get(j, "state"))), rd.n(J.get(j, "tries")), rd.s(J.get(j, "context")), rd.s(J.get(j, "parts"))}

