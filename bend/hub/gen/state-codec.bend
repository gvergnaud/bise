      [J.kv("outbox", J.JArr{Out.journal_list(outbox)}), J.kv("next_xid", J.JNum{next_xid}), J.kv("xin", J.JArr{XIn.journal_list(xin)}), J.kv("routes", J.JArr{Route.journal_list(routes)}), J.kv("next_rid", J.JNum{next_rid})]

