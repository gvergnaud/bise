  for +view: Maybe<&2, String>
  for +works: List<&2, String>
  {rd.n(J.get(J.obj(Sent.journal_kvs(S.Sent{id, thread, from, to, reply_to, expect, auto, text, created, plain, queued, via, parts, fwd, view, works})), "id")) == id : Nat}

