  OutSt.round(e)

def OutSt.opt_journal_of(+j: J.Json) -> Maybe<&2, S.OutSt>:
  OutSt.opt_of(Some{j})

def OutSt.opt_journal_json(m: Maybe<&2, S.OutSt>) -> J.Json:
  OutSt.opt_json(m)

law OutSt.opt_journal_round:
  for m: Maybe<&2, S.OutSt>
  {OutSt.opt_journal_of(OutSt.opt_journal_json(m)) == m : Maybe<&2, S.OutSt>}

def OutSt.opt_journal_round(m):
  OutSt.opt_round(m)

# ---- RSt (its word) ----

def RSt.word(e: S.RSt) -> String:
  match e:
    case S.RHeld{}:
      "held"
    case S.RSent{}:
      "sent"
    case S.RCancelled{}:
      "cancelled"

# any other word: held
def RSt.of_word(+w: String) -> S.RSt:
  Bool.pick(S.RSt, String.eq(w, "sent"), S.RSent{}, Bool.pick(S.RSt, String.eq(w, "cancelled"), S.RCancelled{}, S.RHeld{}))

def RSt.opt_json(m: Maybe<&2, S.RSt>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{+e}:
      J.JStr{RSt.word(e)}

def RSt.opt_of(m: Maybe<&2, J.Json>) -> Maybe<&2, S.RSt>:
  match m:
    case Some{J.JStr{+w}}:
      Some{RSt.of_word(w)}
    case _:
      None{}

law RSt.round:
  for e: S.RSt
  {RSt.of_word(RSt.word(e)) == e : S.RSt}

def RSt.round(e):
  match e:
    case S.RHeld{}:
      {==}
    case S.RSent{}:
      {==}
    case S.RCancelled{}:
      {==}

law RSt.opt_round:
  for m: Maybe<&2, S.RSt>
  {RSt.opt_of(Some{RSt.opt_json(m)}) == m : Maybe<&2, S.RSt>}

def RSt.opt_round(m):
  match m:
    case None{}:
      {==}
    case Some{S.RHeld{}}:
      {==}
    case Some{S.RSent{}}:
      {==}
    case Some{S.RCancelled{}}:
      {==}

def RSt.journal_of(j: J.Json) -> S.RSt:
  match j:
    case J.JStr{+w}:
      RSt.of_word(w)
    case _:
      S.RHeld{}

def RSt.journal_json(e: S.RSt) -> J.Json:
  J.JStr{RSt.word(e)}

law RSt.journal_round:
  for e: S.RSt
  {RSt.journal_of(RSt.journal_json(e)) == e : S.RSt}

def RSt.journal_round(e):
  RSt.round(e)

def RSt.opt_journal_of(+j: J.Json) -> Maybe<&2, S.RSt>:
  RSt.opt_of(Some{j})

def RSt.opt_journal_json(m: Maybe<&2, S.RSt>) -> J.Json:
  RSt.opt_json(m)

law RSt.opt_journal_round:
  for m: Maybe<&2, S.RSt>
  {RSt.opt_journal_of(RSt.opt_journal_json(m)) == m : Maybe<&2, S.RSt>}

def RSt.opt_journal_round(m):
  RSt.opt_round(m)

# ---- Msg, its journal shape: id, thread, from, to, reply_to, expect_reply, auto, text, created_ms, plain, queued, via, parts, fwd, view ----

def Msg.journal_kvs(r: S.Msg) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match r:
    case S.Msg{+id, +thread, +from, +to, +reply_to, +expect, +auto, +text, +created, +plain, +queued, +via, +parts, +fwd, +view}:
      K.cat([[J.kv("id", J.JNum{id}), J.kv("thread", J.JNum{thread}), J.kv("from", J.JStr{from}), J.kv("to", J.JStr{to}), J.kv("reply_to", K.jmaybe_n(reply_to)), J.kv("expect_reply", J.JBool{expect}), J.kv("auto", J.JBool{auto}), J.kv("text", J.JStr{text}), J.kv("created_ms", J.JNum{created}), J.kv("plain", J.JBool{plain}), J.kv("queued", J.JBool{queued})], K.omit_ms("via", via), K.omit_s("parts", parts), K.omit_mn("fwd", fwd), K.omit_ms("view", view)])

def Msg.journal_json(r: S.Msg) -> J.Json:
  J.obj(Msg.journal_kvs(r))

def Msg.journal_of(+j: J.Json) -> S.Msg:
  S.Msg{rd.n(J.get(j, "id")), rd.n(J.get(j, "thread")), rd.s(J.get(j, "from")), rd.s(J.get(j, "to")), K.opt_n(J.get(j, "reply_to")), rd.b(J.get(j, "expect_reply")), rd.b(J.get(j, "auto")), rd.s(J.get(j, "text")), rd.n(J.get(j, "created_ms")), rd.b(J.get(j, "plain")), rd.b(J.get(j, "queued")), K.opt_s(J.get(j, "via")), rd.s(J.get(j, "parts")), K.opt_n(J.get(j, "fwd")), K.opt_s(J.get(j, "view"))}

