  %Equal.sym(Nat, rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "msg")), msg, Out.journal.msg(xid, project, kind, msg, text, st, tries, context, parts)) : {S.Out{xid, project, kind, _, rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "text")), OutSt.of_word(rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "state"))), rd.n(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "tries")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "context")), rd.s(J.get(J.obj(Out.journal_kvs(S.Out{xid, project, kind, msg, text, st, tries, context, parts})), "parts"))} == S.Out{xid, project, kind, msg, text, st, tries, context, parts} : S.Out}
