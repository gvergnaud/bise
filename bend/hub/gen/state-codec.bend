      [J.kv("state", J.JStr{"delivered"})]
    case S.Rejected{+error}:
      [J.kv("state", J.JStr{"rejected"}), J.kv("error", J.JStr{error})]
    case S.Cancelled{}:
      [J.kv("state", J.JStr{"cancelled"})]

