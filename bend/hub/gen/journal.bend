# ---- write: the key-value list, in wire order ----

def kvs(e: M.Ev) -> List<&2, Sigma<&2, &2, String, _ => J.Json>>:
  match e:
    case M.ETaskCreated{+name, +parent, +brief, +ws, +at_ms}:
      [J.kv("type", J.JStr{"task_created"}), J.kv("name", J.JStr{name}), J.kv("parent", J.JStr{parent}), J.kv("brief", brief), J.kv("ws", ws), J.kv("at_ms", J.JNum{at_ms})]
    case M.ELifecycle{+name, +lifecycle, +reason}:
      [J.kv("type", J.JStr{"lifecycle"}), J.kv("name", J.JStr{name}), J.kv("lifecycle", SC.Life.journal_json(lifecycle)), J.kv("reason", K.jmaybe_s(reason))]
    case M.EWorkspace{+name, +ws}:
      [J.kv("type", J.JStr{"workspace_changed"}), J.kv("name", J.JStr{name}), J.kv("ws", ws)]
    case M.ESnapshot{+name, +snapshot_ref}:
      [J.kv("type", J.JStr{"snapshot"}), J.kv("name", J.JStr{name}), J.kv("snapshot_ref", K.jmaybe_s(snapshot_ref))]
    case M.EPlaced{+name, +ws, +err}:
      [J.kv("type", J.JStr{"worktree_placed"}), J.kv("name", J.JStr{name}), J.kv("ws", ws), J.kv("err", J.JStr{err})]
    case M.EDropped{+name, +snapshot, +err}:
      [J.kv("type", J.JStr{"worktree_dropped"}), J.kv("name", J.JStr{name}), J.kv("snapshot", K.jmaybe_s(snapshot)), J.kv("err", J.JStr{err})]
    case M.EDeclared{+name, +status, +note}:
      [J.kv("type", J.JStr{"declared"}), J.kv("name", J.JStr{name}), J.kv("status", SC.Decl.opt_journal_json(status)), J.kv("note", J.JStr{note})]
    case M.EReported{+name, +report}:
      [J.kv("type", J.JStr{"reported"}), J.kv("name", J.JStr{name}), J.kv("report", report)]
    case M.EFileTouched{+name, +path}:
      [J.kv("type", J.JStr{"file_touched"}), J.kv("name", J.JStr{name}), J.kv("path", J.JStr{path})]
    case M.EClaimDropped{+name, +path}:
      [J.kv("type", J.JStr{"claim_dropped"}), J.kv("name", J.JStr{name}), J.kv("path", J.JStr{path})]
    case M.ERenamed{+name, +new_name}:
      [J.kv("type", J.JStr{"renamed"}), J.kv("name", J.JStr{name}), J.kv("new_name", J.JStr{new_name})]
    case M.EMsgsMoved{+from, +to}:
      [J.kv("type", J.JStr{"msgs_moved"}), J.kv("from", J.JStr{from}), J.kv("to", J.JStr{to})]
    case M.EMsgSent{+msg}:
      [J.kv("type", J.JStr{"message_sent"}), J.kv("msg", SC.Msg.journal_json(msg))]
    case M.EMsgState{+id, +state}:
      K.cat([[J.kv("type", J.JStr{"message_state"}), J.kv("id", J.JNum{id})], SC.MSt.journal_kvs(state)])
    case M.ESettled{+id}:
      [J.kv("type", J.JStr{"message_settled"}), J.kv("id", J.JNum{id})]
    case M.ECardOpened{+card}:
      [J.kv("type", J.JStr{"card_opened"}), J.kv("card", SC.Card.journal_json(card))]
    case M.ECardClosed{+id, +resolution, +ans}:
      K.cat([[J.kv("type", J.JStr{"card_closed"}), J.kv("id", J.JNum{id}), J.kv("resolution", J.JStr{resolution})], SC.Ans.journal_kvs(ans)])
    case M.ECardAnswerPos{+card, +agent, +pos}:
      [J.kv("type", J.JStr{"card_answer_pos"}), J.kv("card", J.JNum{card}), J.kv("agent", J.JStr{agent}), J.kv("pos", J.JNum{pos})]
    case M.ECardWithdrawn{+id, +text}:
      [J.kv("type", J.JStr{"card_withdrawn"}), J.kv("id", J.JNum{id}), J.kv("text", J.JStr{text})]
    case M.ECardLate{+id}:
      [J.kv("type", J.JStr{"card_late"}), J.kv("id", J.JNum{id})]
    case M.EMainNote{+text, +at_ms}:
      [J.kv("type", J.JStr{"main_note"}), J.kv("text", J.JStr{text}), J.kv("at_ms", J.JNum{at_ms})]
    case M.ENotesFlushed{}:
      [J.kv("type", J.JStr{"main_notes_flushed"})]
    case M.ETimerSet{+timer, +at}:
      K.cat([[J.kv("type", J.JStr{"every_set"})], SC.Timer.journal_kvs(timer), [J.kv("at", J.JNum{at})]])
    case M.ETimerFired{+id, +fired, +next_ms, +at, +undelivered}:
      K.cat([[J.kv("type", J.JStr{"every_fired"}), J.kv("id", J.JNum{id}), J.kv("fired", J.JNum{fired}), J.kv("next_ms", J.JNum{next_ms}), J.kv("at", J.JNum{at})], K.flag("undelivered", undelivered)])
    case M.ETimerRun{+id, +at}:
      [J.kv("type", J.JStr{"every_run"}), J.kv("id", J.JNum{id}), J.kv("at", J.JNum{at})]
    case M.ETimerStop{+id, +why, +at}:
      [J.kv("type", J.JStr{"every_stop"}), J.kv("id", J.JNum{id}), J.kv("why", J.JStr{why}), J.kv("at", J.JNum{at})]
    case M.ETimerName{+id, +name, +announce, +at}:
      K.cat([[J.kv("type", J.JStr{"every_name"}), J.kv("id", J.JNum{id}), J.kv("name", J.JStr{name}), J.kv("at", J.JNum{at})], K.flag("announce", announce)])
    case M.EX{XH.XOut{+out}}:
      [J.kv("type", J.JStr{"x_out"}), J.kv("out", SC.Out.journal_json(out))]
    case M.EX{XH.XOp{+xid, XH.OpAcked{}}}:
      [J.kv("type", J.JStr{"x_acked"}), J.kv("xid", J.JNum{xid})]
    case M.EX{XH.XOp{+xid, XH.OpTried{}}}:
      [J.kv("type", J.JStr{"x_failed"}), J.kv("xid", J.JNum{xid})]
    case M.EX{XH.XOp{+xid, XH.OpSettled{}}}:
      [J.kv("type", J.JStr{"x_settled"}), J.kv("xid", J.JNum{xid})]
    case M.EX{XH.XGot{+in}}:
      [J.kv("type", J.JStr{"x_in"}), J.kv("in", SC.XIn.journal_json(in))]
    case M.EX{XH.XReplied{+hub, +xid}}:
      [J.kv("type", J.JStr{"x_replied"}), J.kv("hub", J.JStr{hub}), J.kv("xid", J.JNum{xid})]
    case M.EX{XH.XRouteHeld{+route}}:
      [J.kv("type", J.JStr{"route_held"}), J.kv("route", SC.Route.journal_json(route))]
    case M.EX{XH.XRoute{+rid, XH.RTo{+to, +name}}}:
      [J.kv("type", J.JStr{"route_set"}), J.kv("rid", J.JNum{rid}), J.kv("to", J.JStr{to}), J.kv("name", J.JStr{name})]
    case M.EX{XH.XRoute{+rid, XH.REnd{S.RSent{}}}}:
      [J.kv("type", J.JStr{"route_sent"}), J.kv("rid", J.JNum{rid})]
    case M.EX{XH.XRoute{+rid, XH.REnd{S.RCancelled{}}}}:
      [J.kv("type", J.JStr{"route_cancelled"}), J.kv("rid", J.JNum{rid})]
    case M.EAct{TM.ActSet{+act}}:
      [J.kv("type", J.JStr{"act_set"}), J.kv("act", SC.Act.journal_json(act))]
    case M.EAct{TM.ActDone{+id}}:
      [J.kv("type", J.JStr{"act_done"}), J.kv("id", J.JNum{id})]
    case M.EFollow{+name, +on, +hub}:
      [J.kv("type", J.JStr{"follow"}), J.kv("name", J.JStr{name}), J.kv("on", J.JBool{on}), J.kv("hub", J.JStr{hub})]
    case M.EJobEnd{+name, +state}:
      [J.kv("type", J.JStr{"job_end"}), J.kv("name", J.JStr{name}), J.kv("state", J.JStr{state})]
    case M.EWake{WK.WSet{+watch}}:
      [J.kv("type", J.JStr{"wake_set"}), J.kv("watch", SC.Watch.journal_json(watch))]
    case M.EWake{WK.WEnd{+id, +why, +at}}:
      [J.kv("type", J.JStr{"wake_end"}), J.kv("id", J.JNum{id}), J.kv("why", J.JStr{why}), J.kv("at", J.JNum{at})]
    case M.EPaused{+at}:
      [J.kv("type", J.JStr{"paused"}), J.kv("at", J.JNum{at})]
    case M.EResumed{+at}:
      [J.kv("type", J.JStr{"resumed"}), J.kv("at", J.JNum{at})]
    # never journaled (journal.rs NEVER): written as it always was
    case M.EX{XH.XRoute{+rid, XH.REnd{S.RHeld{}}}}:
      [J.kv("type", J.JStr{"route_held"}), J.kv("rid", J.JNum{rid})]

# one event's journal line
def json(e: M.Ev) -> J.Json:
  J.obj(kvs(e))
