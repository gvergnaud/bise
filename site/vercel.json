{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/install(.sh)?",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/setup.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/docs/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/design.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.sh"
    },
    {
      "source": "/artifacts",
      "destination": "https://bise-artifacts.vercel.app/artifacts"
    },
    {
      "source": "/artifacts/:path*",
      "destination": "https://bise-artifacts.vercel.app/artifacts/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/screens",
      "destination": "/book/screens",
      "permanent": false
    }
  ]
}
