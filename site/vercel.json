{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/install(.sh)?",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/setup.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/docs/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/design.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/telemetry/purge",
      "schedule": "17 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.sh"
    },
    {
      "source": "/v1/packets",
      "has": [{ "type": "host", "value": "telemetry.bise.dev" }],
      "destination": "/api/telemetry/packets"
    },
    {
      "source": "/v1/delete",
      "has": [{ "type": "host", "value": "telemetry.bise.dev" }],
      "destination": "/api/telemetry/delete"
    },
    {
      "source": "/telemetry",
      "destination": "/api/telemetry/dashboard"
    },
    {
      "source": "/artifacts",
      "destination": "https://bise-artifacts.vercel.app/artifacts"
    },
    {
      "source": "/artifacts/:path*",
      "destination": "https://bise-artifacts.vercel.app/artifacts/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/screens",
      "destination": "/book/screens",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/desktop",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "https://github.com/gvergnaud/bise/releases/download/desktop-latest/bise-mac-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/download/mac-beta",
      "destination": "https://github.com/gvergnaud/bise/releases/download/desktop-beta/bise-mac-arm64.dmg",
      "permanent": false
    }
  ]
}
