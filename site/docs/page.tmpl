<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{head_title}}</title>
<meta name="description" content="{{description}}">
<link rel="canonical" href="{{canonical}}">
<meta name="theme-color" content="#f2ede2">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="text/markdown" href="{{md}}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="bise">
<meta property="og:url" content="{{canonical}}">
<meta property="og:title" content="{{head_title}}">
<meta property="og:description" content="{{description}}">
<meta property="og:image" content="https://bise.dev/og.png?v=paper">
<meta name="twitter:card" content="summary_large_image">
<script>{ const q = location.search; let d = null; try { d = localStorage.getItem('bise-theme'); } catch {} if (/[?&]dark\b/.test(q) || (!/[?&]light\b/.test(q) && (d ?? (matchMedia('(prefers-color-scheme: dark)').matches ? '1' : '0')) === '1')) document.documentElement.classList.add('pd'); }</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Caveat:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/docs/docs.css">
</head>
<body>
<header class="top">
  <button class="menu" type="button" aria-label="the pages" aria-expanded="false">≡</button>
  <a class="logo" href="/">bise <span class="acc">:*</span></a>
  <a class="docs" href="/docs">docs</a>
  <div class="search">
    <input type="search" placeholder="/ search" aria-label="search the docs" autocomplete="off" spellcheck="false">
    <div class="results" hidden></div>
  </div>
  <nav>
    <a href="https://github.com/gvergnaud/bise">GitHub</a>
    <button id="theme" type="button" title="light / dark">◐</button>
  </nav>
</header>
<div class="wrap">
  <aside class="side"><nav aria-label="the docs">
{{sidebar}}
  </nav></aside>
  <main>
    <article>
      <div class="head">
        <h1>{{title}}</h1>
        <button class="copymd" type="button" data-md="{{md}}">copy as markdown</button>
      </div>
      <p class="lede">{{description}}</p>
{{body}}
    </article>
    <nav class="pn">{{prevnext}}</nav>
    <footer>
      <p>for agents: <a href="{{md}}">{{md_url}}</a></p>
      <p><a href="{{edit}}">edit this page on GitHub</a></p>
    </footer>
  </main>
  <aside class="toc">{{toc}}</aside>
</div>
<script src="/docs/docs.js" defer></script>
</body>
</html>
