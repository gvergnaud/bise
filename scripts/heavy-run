#!/bin/bash
# heavy-run [--alone] [--land] [--low] [--prio] <command...>
# heavy-run --install   copy this file to ~/.bise/run/heavy-run (new file + mv)
# The source of ~/.bise/run/heavy-run (scripts/heavy-run, since flow-time,
# 2026-10-20; tests/heavy_run_test.py). Runs a heavy job (cargo, gates,
# builds, playwright, test:land) in a shared slot: 4 slots on AC power, 2 on
# battery (the user's rule: 2 since 2026-10-09, « on peut paralléliser » on
# AC, 2026-10-18). nice 10 on AC, 15 on battery. The disk and CPU budget
# (mac-budget, 2026-10-21; docs/loop-speed.md §10.7): a disk reserve per
# job and the reclaim of idle cargo targets (scripts/disk_reclaim.py,
# --install puts it next to this file), a time limit per job (rc 124),
# threads per slot, and the admission below (a quiet window, a load ceiling, a
# floor per lane, a bar on our own jobs' CPU).
# heavy-run quiet <what> -- <command...>: the release's automatic quiet window (main m_63082,
# architect m_63085): while <command> runs (a timing-bound step: the tip gate's e2e/tmux, as-he-
# does, the desktop checks), it holds an exclusive flock on ~/.bise/run/quiet/<what>.lock, and no
# job starts but the release lane's (--prio), floors included. A killed wrapper frees its lock by
# itself. One line per window in heavy.log: quiet <what> <start> <end> <min> <tickets held>.
# Admission, for a job outside the release lane, each poll: (1) a quiet window open: wait;
# (2) the Mac's 1-min load at or over HEAVY_LOAD_CEILING (2 x the cores): wait, floors included;
# (3) its lane's floor: a lane with none of its jobs running starts its first one (the agents'
# lane, ranks 1-2; the low lane, rank 3, while fewer than 2 agent jobs run); (4) else the bar:
# our running jobs' CPU (their process trees by ppid, one ps snapshot: disk_reclaim.py --admit)
# under HEAVY_JOBS_CPU (75 % of the cores, in % of one core: 900 on 12) and HEAVY_START_GAP (20) s
# after the last start. Before (until 11-12) the bar was the whole Mac's load, which agents'
# REPLs, hubs and light gates held over 2 x cores for hours: 147 min of waits on 11-12 came with
# 0-1 jobs of ours running (fast-loop, main m_63076, architect m_63083).
# Its knobs and disk_reclaim.py's, script-only (not in bise_home's VARS):
#   HEAVY_DISK_WAIT_GB (10) the floor a job waits for; HEAVY_DISK_STOP_GB (5)
#   a running job stops; HEAVY_RECLAIM_UNDER_GB (20) a running job's reclaim
#   starts; HEAVY_IDLE_TARGET_H (6) a target unused that long goes;
#   HEAVY_MIN_IDLE_MIN (30) the least idle a target is trimmed or deleted at;
#   HEAVY_TRIM_GB (4) a green-marked target's own bytes past which it is
#   trimmed; HEAVY_OWN_CAP_GB (10) a job's own targets' own bytes past which they
#   are trimmed at its admission, measured at most every HEAVY_OWN_GAP_MIN (10);
#   HEAVY_CAND_KEEP_H (24) the age past which a desktop candidate in ~/.bise/dev/build/
#   desktop-cand goes (never the newest, one a nightly kept, one in use: disk_reclaim.py's
#   reclaimable()); HEAVY_TMP_CAP_GB (2) an agent tmp's size printed once. A job gets, beside
#   HEAVY_SLOT, HEAVY_CPUS: the cpus over the heavy jobs running at its start,
#   itself included (vitest's workers, apps/desktop/src/test-workers.ts); tests:
#   HEAVY_RECLAIM_ROOTS, HEAVY_RECLAIM_SHARED (the shared trees, found from the
#   worktrees' .git files otherwise), HEAVY_RECLAIM_KEEP, HEAVY_TMP_ROOTS,
#   HEAVY_FREE_KB_FILE, HEAVY_DISK_VOLUME, HEAVY_RECLAIM, HEAVY_RECLAIM_GAP.
#   slot 1 = ~/.bise/run/heavy.lock (the old single lock: old callers still count)
#   slot 2 = ~/.bise/run/heavy2.lock
#   slots 3-4 = ~/.bise/run/heavy3.lock, heavy4.lock (AC power only)
#   slot 5 = ~/.bise/run/heavy5.lock, the release lane (fast-loop, his pick on
#     page loop-4min: « une voie release ... le verdict ne bloque personne mais
#     charge plus la machine »): only a --prio job takes it, and a --prio job
#     tries it first, so a release's verdict never waits for the agents' 4
#     slots and never takes one of them while the lane is free.
#   slot 6 = ~/.bise/run/heavy6.lock, the release pass's second lane (release-speed plan A step
#     7, architect m_63312, marketing m_63313): only a --prio job with HEAVY_PASS_LANE=A|B takes
#     it, which only scripts/release_cut.sh pass sets (lane A the tip gate, lane B the app side);
#     a plain --prio never does. Such a job waits while the OTHER lane runs a timing-bound step
#     (its quiet window holds ~/.bise/run/quiet/pass-timing.lock, one at a time across both lanes),
#     so no build of one lane starts under the other's timing; one already running goes on.
# The queue (flow-time, 2026-10-20): each waiting job holds a ticket,
# ~/.bise/run/queue/<rank>-<submitted>-<pid>; a job takes a free slot only
# when fewer live tickets are ahead of it than slots are free, so jobs start
# by rank, then first come first served (before: every waiter polled every
# 2 s and the luckiest got the slot; 25 % of the tasks' spawn-to-main time
# was this queue). Ranks:
#   0 --prio  the user's priority work (his own ask, never an experiment)
#   1 a land check, one step from main: tests/gate.sh full or rerun,
#     pnpm test:land, or --land (a wrapper script that runs one of them);
#     the nightly (scripts/nightly_gate.sh)
#   2 the rest
#   3 --low   experiments, load tests, shots, repacks: whatever no land waits on
# --alone takes every slot (the nightly, a benchmark that needs a quiet
#         machine), in its rank's turn; while it waits for them no job
#         behind it starts. On battery it waits for AC power. A slot held without
#         heavy-run (an old caller's lockf) is busy all the same: every slot
#         is probed.
# heavy.log: a line when the job gets its slot, "<submitted> <started> -
# <slot> <cwd> <command> waited=disk:<s> slot:<s> load:<s> batt:<s>" (what it
# waited on, review-gates m_37641), and one when it ends, "<submitted> <started>
# <ended> <slot> <cwd> <command> rc=<n>" (scripts/loop_audit.py reads both).
# The whole body is one function, read before it runs: an edit of this file
# while jobs wait in it can't make them run half-old, half-new text (bash
# reads a script as it goes; an in-place edit killed a waiting job with
# "said: unbound variable", 2026-10-12). --install writes a new file + mv.
heavy_run() {
set -u
if [ "${1:-}" = --install ]; then
  dst="$HOME/.bise/run/heavy-run"
  mkdir -p "${dst%/*}" && cp "$0" "$dst.new.$$" && chmod 755 "$dst.new.$$" && mv -f "$dst.new.$$" "$dst" \
    && echo "installed $dst" || return $?
  # its disk reclaim, next to it (scripts/disk_reclaim.py)
  src="$(cd "$(dirname "$0")" && pwd)/disk_reclaim.py"
  cp "$src" "${dst%/*}/disk_reclaim.py.new.$$" && mv -f "${dst%/*}/disk_reclaim.py.new.$$" "${dst%/*}/disk_reclaim.py" \
    && echo "installed ${dst%/*}/disk_reclaim.py"
  return $?
fi
if [ "${1:-}" = quiet ]; then
  [ $# -ge 4 ] && [ "$3" = -- ] && [[ "$2" =~ ^[a-z0-9-]+$ ]] || { echo "usage: heavy-run quiet <what> -- <command...>" >&2; return 2; }
  local what="$2" qd="$HOME/.bise/run/quiet" t0 rc held; shift 3
  mkdir -p "$qd"; t0=$(date +%s)
  local pass="${HEAVY_PASS_LANE:-}" pre=()
  case "$pass" in A|B) ;; *) pass="" ;; esac
  # a release pass's lane (slot 6 in the header): one timing-bound step at a time across both
  # lanes, waited for; its marker names the lane, which the other lane's admission reads
  if [ -n "$pass" ]; then
    pre=(/usr/bin/lockf -k "$qd/pass-timing.lock" /bin/bash -c 'printf "%s %s since %s\n" "$1" "$2" "$(date "+%F %T")" >"$3"; shift 3; "$@"' _ "$pass" "$what" "$qd/pass-timing.lock")
  fi
  # the marker's line is for the logs only: admission tries a shared flock, never reads it
  ${pre[@]+"${pre[@]}"} /usr/bin/lockf -k "$qd/$what.lock" /bin/bash -c 'printf "%s since %s\n" "$1" "$(date "+%F %T")" >"$2"; shift 2; "$@"' \
    _ "$what" "$qd/$what.lock" "$@"; rc=$?
  held=$(ls "$HOME/.bise/run/queue" 2>/dev/null | grep -vc '^0-')
  printf "quiet\t%s\t%s\t%s\t%s\t%s\n" "$what" "$t0" "$(date +%s)" "$(( ($(date +%s) - t0) / 60 ))" "$held" >>"$HOME/.bise/run/heavy.log"
  # the moment main may lift a hold (marketing m_62928: lifted too early on 11-12); in a release
  # pass, release_cut.sh says it once, after the pass's last window (marketing m_63313 d)
  if [ -n "$pass" ]; then
    echo "heavy-run: quiet window '$what' (lane $pass) closed after $(( ($(date +%s) - t0) / 60 )) min (rc $rc)" >&2
  else
    echo "heavy-run: timing-bound part done: quiet window '$what' closed after $(( ($(date +%s) - t0) / 60 )) min (rc $rc)" >&2
  fi
  return $rc
fi
# no heavy-run inside a heavy job (gate-reds, main m_33473): a job holding a
# slot that asks for one again waits on the others, and a --alone job holding
# the other 3 waits for its slot: both wait forever (pr20's run.sh, 40 min on
# 2026-10-19). Each job runs with HEAVY_SLOT="<slot> <pid>" (below); a call
# with that pid among its ancestors is refused. A HEAVY_SLOT inherited by a
# process that outlived its job (a daemon) is not an ancestor: it may run.
if [ -n "${HEAVY_SLOT:-}" ]; then
  hp="${HEAVY_SLOT##* }" p=$$
  while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
    if [ "$p" = "$hp" ]; then
      echo "heavy-run: refused: this command already runs inside a heavy job (slot ${HEAVY_SLOT% *}, pid $hp); a nested heavy-run waits for a second slot while holding one, and deadlocks against a --alone job. Run it directly: the slot you hold covers it." >&2
      return 2
    fi
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
fi
# launchd jobs start with maxfiles 256: bend-tui's tests then panic on
# UnixStream::pair() (EMFILE) and a full gate goes red for nothing (core-b,
# 2026-10-12). Raise the soft limit for every heavy job, whoever starts it.
ulimit -n 10240 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null || true
D="$HOME/.bise/run"
S1="$D/heavy.lock"
S2="$D/heavy2.lock"
S3="$D/heavy3.lock"
S4="$D/heavy4.lock"
S5="$D/heavy5.lock"
S6="$D/heavy6.lock"
Q="$D/queue"
mkdir -p "$D" "$Q" && touch "$S1" "$S2" "$S3" "$S4" "$S5" "$S6"
# a release pass's lane (A|B, release_cut.sh pass; the header's slot 6), else none
PASS_LANE="${HEAVY_PASS_LANE:-}"
case "$PASS_LANE" in A|B) ;; *) PASS_LANE="" ;; esac

# the disk (disk-guard, 2026-10-20: agents' builds filled it, macOS hit
# 'critical low disk' and killed the app and every Chrome tab at 17:48). A
# job waits for a slot while the data volume has under HEAVY_DISK_WAIT_GB
# (10; 15 before 2026-10-22) free, saying why; a running job is stopped (its process tree,
# TERM then KILL after 5 s) when it drops under HEAVY_DISK_STOP_GB (5), with
# rc=28 (ENOSPC) and a "heavy-run: stopped" line. Both also go to the
# agent's status (sb status, when SB_AGENT is set), so the hub shows why.
# Known limits (review-gates m_35740): the stop follows parent pids, so a
# child that left the tree (setsid, a daemon, a hub a test started) is not
# stopped; the status note sets the agent to 'working', over a blocked or
# done status. Without SB_AGENT (the nightly under launchd) the lines are
# only on stderr: the nightly's <date>.log has them (its 2>&1).
# HEAVY_FREE_KB_FILE (tests): the free KB are read from that file, not df.
# HEAVY_DISK_VOLUME (the simulated fill): that volume's free space instead.
# HEAVY_DISK_POLL: seconds between two checks of a running job (10).
free_kb() {
  if [ -n "${HEAVY_FREE_KB_FILE:-}" ]; then cat "$HEAVY_FREE_KB_FILE" 2>/dev/null; return; fi
  local v=${HEAVY_DISK_VOLUME:-/System/Volumes/Data}; [ -d "$v" ] || v="$HOME"
  df -k "$v" 2>/dev/null | awk 'NR==2 {print $4}'
}
# under $1 GB free (an unreadable free space counts as enough)
disk_under() { local k; k=$(free_kb); [ -n "$k" ] && [ "$k" -lt $(( $1 * 1048576 )) ] 2>/dev/null; }
free_gb() { local k; k=$(free_kb); echo $(( ${k:-0} / 1048576 )); }
tell_hub() {
  [ -n "${SB_AGENT:-}" ] && command -v sb >/dev/null 2>&1 && sb status working --note "$1" >/dev/null 2>&1 || true
}
# the process tree under $1, but for $2's (the watcher's own)
tree() { local c; for c in $(pgrep -P "$1"); do [ "$c" = "$2" ] && continue; tree "$c" "$2"; echo "$c"; done; }
# the disk reclaim (mac-budget, 2026-10-21): scripts/disk_reclaim.py,
# installed next to this file, deletes the agents' idle cargo targets (its
# header has the rule). Started in the background, never twice at once (its
# own lock), at most once a minute: reclaim <want GB> when the disk is under
# what a job needs; reclaim 0 (the idle ones only) at most every 10 min, at
# each job's start. HEAVY_RECLAIM (tests): the command instead;
# HEAVY_RECLAIM_GAP (the simulated fill): seconds between two, not 60.
reclaim() {
  local s="$HOME/.bise/run/reclaim.stamp" gap="${HEAVY_RECLAIM_GAP:-60}" now
  [ "$1" = 0 ] && { s="$s.idle"; gap=600; }
  now=$(date +%s)
  [ -e "$s" ] && [ $(( now - $(stat -f %m "$s" 2>/dev/null || echo 0) )) -lt "$gap" ] && return 0
  touch "$s"
  local r="${HEAVY_RECLAIM:-/usr/bin/python3 $HOME/.bise/run/disk_reclaim.py}"
  # the idle pass (want 0) runs at the background QoS (taskpolicy -b: the lowest CPU priority, its
  # disk I/O throttled): nothing waits on it. On 11-12 one ran 1h07 at load 110-142 (two reclones,
  # three target deletions: millions of file ops that fseventsd, mds and the endpoint agent also
  # read), and the load fell from 78 to 37 the minute it ended (main m_62979). A want pass (a job
  # waits for that disk) keeps its priority.
  [ "$1" = 0 ] && [ -z "${HEAVY_RECLAIM:-}" ] && [ -x /usr/sbin/taskpolicy ] && r="/usr/sbin/taskpolicy -b $r"
  # fds 3-9 closed: a job's slot lock (lockf's fd, 3; 3-6 for --alone) must
  # not outlive the job in a reclaim that runs on
  # reclaim.mark (touched at its start and end) and reclaim.running (while it
  # runs); what it freed is in reclaim.log, each deletion's GB with its time:
  # a job's measure adds it back (review-gates m_37215, m_37481)
  local d="$HOME/.bise/run"
  # (a double fork, as before: never a child of the job, so a stop of the
  # job's tree or an --alone job's CPU count never includes it)
  ( ( touch "$d/reclaim.mark"; : >"$d/reclaim.running"; $r --want "$1" >>"$d/reclaim.out" 2>&1
      rm -f "$d/reclaim.running"; touch "$d/reclaim.mark" ) 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- & ) </dev/null >/dev/null 2>&1
}
# runs in the background of a job's shell ($1): marks $2 ("disk <GB>" or
# "time <min>") and stops the job when the disk gets too low or the job runs
# over HEAVY_MAX_MIN ($3) minutes; under HEAVY_RECLAIM_UNDER_GB (20; the floor,
# 10, before disk-hygiene, architect m_55867) it reclaims first (the idle
# targets' incremental dirs, then idle targets), so a job that grows a
# target is not the one that pays.
# $4 (an --alone job's, HEAVY_IDLE_MIN): minutes awake with no CPU used by
# the job's processes (under HEAVY_IDLE_CPU_CS, 200 = 2 s, in all), past which it is stuck: stopped
# too (main m_36953: a caffeinate with no child, 0 % CPU for 3 h, held
# every slot). Its CPU is read every HEAVY_IDLE_POLL (60) s.
cpu_cs() { # the CPU centiseconds of the pids $@, summed (ps's [[h:]m]m:ss.cc)
  [ $# -gt 0 ] || { echo 0; return; }
  ps -o time= -p "$(echo "$@" | tr ' ' ',')" 2>/dev/null |
    awk '{ n = split($1, a, ":"); s = 0; for (i = 1; i <= n; i++) s = s * 60 + a[i]; t += s } END { printf "%d\n", t * 100 }'
}
disk_watch() {
  local me=$BASHPID last now ran=0 why="" step busy_ran=0 cpu=0 c seen=0 k mn=""
  last=$(date +%s)
  while kill -0 "$1" 2>/dev/null; do
    # $5: the lowest free KB seen while it runs (its disk.tsv line)
    if [ -n "${5:-}" ]; then
      k=$(free_kb); [ -n "$mn" ] || mn=$(cat "$5" 2>/dev/null)
      [ -n "$k" ] && { [ -z "$mn" ] || [ "$k" -lt "$mn" ] 2>/dev/null; } && { mn=$k; echo "$k" >"$5"; }
    fi
    # the time it ran awake: a gap between two checks counts 30 s at most,
    # so a night the Mac slept (2026-10-20, 21:43 to 10:20, an empty
    # battery) is not a stuck job
    now=$(date +%s); step=$(( now - last )); [ "$step" -gt 30 ] && step=30; ran=$(( ran + step )); last=$now
    if [ "${4:-0}" -gt 0 ] && [ $(( ran - seen )) -ge "${HEAVY_IDLE_POLL:-60}" ]; then
      seen=$ran; c=$(cpu_cs $(tree "$1" "$me"))
      [ $(( c - cpu )) -ge "${HEAVY_IDLE_CPU_CS:-200}" ] && { cpu=$c; busy_ran=$ran; }
    fi
    if disk_under "${HEAVY_DISK_STOP_GB:-5}"; then why="disk $(free_gb)"
    elif [ "${3:-0}" -gt 0 ] && [ "$ran" -ge "${HEAVY_MAX_SEC:-$(( $3 * 60 ))}" ]; then why="time $3"
    elif [ "${4:-0}" -gt 0 ] && [ $(( ran - busy_ran )) -ge "${HEAVY_IDLE_SEC:-$(( $4 * 60 ))}" ]; then why="idle $4"
    elif disk_under "${HEAVY_RECLAIM_UNDER_GB:-20}"; then reclaim $(( ${HEAVY_RECLAIM_UNDER_GB:-20} + 10 ))
    fi
    if [ -n "$why" ]; then
      echo "$why" >"$2"
      kill -TERM $(tree "$1" "$me") 2>/dev/null
      sleep 5
      kill -KILL $(tree "$1" "$me") 2>/dev/null
      return
    fi
    sleep "${HEAVY_DISK_POLL:-10}"
  done
}
# a quick gate's kind from its own plan (fast-loop, architect m_60481; main m_60116: a quick
# gate with no Rust change was a cargo job, 10 GB for itself and up to 20 for every waiter,
# while it wrote ~0, and 6 agents waited at 32 GB free behind 2 jobs): the tree's own
# tests/gate_plan.py JSON for the paths gate.sh light plans from, read as data (every tree has
# these fields, so it works before a rebase). 'desktop' when it has a desktop or office step and
# no cargo one (pkgs, sb-core, PROOF, core_gen, proto_ts, crossterm), else nothing (the cargo
# kinds below; a plan that fails too).
gate_kind() {
  local w gs="" prev=""
  for w in "$@"; do
    [ "$w" = quick ] && case "$prev" in *gate.sh) gs=$prev ;; esac
    prev=$w
  done
  [ -n "$gs" ] && [ -f "$gs" ] || return 0
  local r; r=$(cd "$(dirname "$gs")/.." 2>/dev/null && pwd) || return 0
  [ -f "$r/tests/gate_plan.py" ] || return 0
  # the paths gate.sh light plans from (its diff from GATE_BASE or HEAD, and the new files)
  ( cd "$r" || exit 0; IFS=$'\n'; set -f
    ch=$( { git diff --name-only "${GATE_BASE:-HEAD}"; git ls-files --others --exclude-standard; } 2>/dev/null | sort -u )
    # shellcheck disable=SC2086  # one path a word (IFS: newline)
    python3 -B tests/gate_plan.py -- $ch ) 2>/dev/null | python3 -c '
import json, sys
p = json.load(sys.stdin); f = p.get("flags") or {}
cargo = p.get("pkgs") or p.get("hub_changed") or p.get("bend_changed") or p.get("core_gen") \
    or f.get("proto_ts") or f.get("crossterm_changed")
print("desktop" if not cargo and (p.get("desktop") or f.get("office") or f.get("office_skills")) else "")' 2>/dev/null
  return 0
}
# a job's kind, for its disk reserve: full (a full gate, the nightly,
# --alone), cargo-warm or cargo-cold (a cargo build or test, a gate, a
# bins/versions build, run_all: warm when a target cargo will use exists,
# cargo's CACHEDIR.TAG in the repo's target, rust/'s, the task dir's that
# gate.sh clones from its seed, or CARGO_TARGET_DIR), other
job_kind() {
  case " $* " in
    *"gate.sh full"*|*nightly_gate.sh*|*" --alone "*) echo full; return ;;
    *"gate.sh quick"*) [ "$(gate_kind "$@")" = desktop ] && { echo desktop; return; } ;;
    *cargo*|*gate.sh*|*bins.sh*|*"versions.sh build"*|*run_all.sh*) ;;
    *) echo other; return ;;
  esac
  local r t; r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$PWD
  for t in "${CARGO_TARGET_DIR:-/nonexistent}" "$r/rust/target" "$r/target" "$r/../target"; do
    [ -e "$t/CACHEDIR.TAG" ] && { echo cargo-warm; return; }
  done
  echo cargo-cold
}
# the dirs a job of kind $1 writes into, relative to its tree (CARGO_TARGET_DIR as set): what it
# grew them by is its disk.tsv row (src=own; disk_reclaim.py --grown, architect m_60879). One row
# a kind: a new kind adds a row here, not a branch. No dirs (other): the volume's free-drop row.
kind_dirs() {
  case "$1" in
    full|cargo-warm|cargo-cold) echo "rust/target target ../target ${CARGO_TARGET_DIR:-}" ;;
    desktop) echo "apps/desktop/out apps/desktop/node_modules/.vite apps/desktop/.harness-cache" ;;
  esac
}
# the GB a job of kind $1 may still write (its reserve), from what jobs of
# that kind really wrote (fast-loop, main m_37136: 5 agents waited at 42 GB
# free while 3 jobs reserved a flat 10 GB each): the p90 of the last 20 of
# that kind in ~/.bise/run/disk.tsv, rounded up, at least 1, never over the
# flat guess. Under 5 measured (review-gates m_37560: 20 before, when the
# long jobs logged '-'; a cold cargo job asked its flat 10 and 3 agents sat
# at 25-27 GB), the flat guess: full and cargo-cold 10 (a
# cold target grew 8-11 GB on 2026-10-20), cargo-warm 3, other 2.
# HEAVY_RESERVE_GB wins.
reserve_gb() {
  [ -n "${HEAVY_RESERVE_GB:-}" ] && { echo "$HEAVY_RESERVE_GB"; return; }
  local flat; case "$1" in full|cargo-cold) flat=10 ;; cargo-warm) flat=3 ;; *) flat=2 ;; esac
  p90_gb "$1" 5 "$flat" 1 "$flat"
}
# p90_gb <kind> <min runs> <under that: this> <at least> <at most>: the p90 GB
# (rounded up) of the last 20 measured runs of that kind in disk.tsv. Only the rows of
# what its jobs grew their own dirs by (src=own, or src=target before 11-11; architect
# m_60754, m_60879) for the cargo kinds and full always, and for any kind once 10 exist:
# a free-drop row charged every other writer to the job. The old rows stay as history.
p90_gb() {
  awk -F'\t' -v k="$1" -v min="$2" -v dflt="$3" -v lo="$4" -v hi="$5" '
    $2 == k && $3 ~ /^[0-9]+$/ { a[na++ % 20] = $3; if ($8 == "src=own" || $8 == "src=target") o[no++ % 20] = $3 }
    END { own = k ~ /^(full|cargo-warm|cargo-cold)$/ || no >= 10
          n = own ? no : na; for (i = 0; i < 20; i++) w[i] = own ? o[i] : a[i]
          m = n < 20 ? n : 20
          if (m < min || m == 0) { print dflt; exit }
          for (i = 0; i < m; i++) v[i] = w[i]
          for (i = 1; i < m; i++) { x = v[i]; for (j = i - 1; j >= 0 && v[j] > x; j--) v[j + 1] = v[j]; v[j + 1] = x }
          i = int(0.9 * m + 0.999) - 1; g = int((v[i] + 1048575) / 1048576)
          if (g < lo) g = lo; if (hi != "" && g > hi) g = hi; print g }' "$HOME/.bise/run/disk.tsv" 2>/dev/null || echo "$3"
}
# what a RUNNING job of kind $1 may still write, for the jobs that wait
# (main m_37463, Gabriel: « on ship beaucoup trop lentement »: agents sat
# for hours at 25 GB free behind the running jobs' flat 10 GB guesses): the
# measured p90 of its kind in disk.tsv, from 10 measured runs on (review-gates
# m_37481, m_37660: at 5 the p90 is the max, and one 6.5 GB script made every
# running 'other' job count 7; at 10 it is the second largest); under 10, the
# flat guess. The bias: a job a reclaim overlaps logs
# '-', and the long ones nearly always do (a gate quick, a release build), so
# today the measure sees the short jobs and leans LOW (cargo-cold's 1 GB is
# small cargo tests; a running gate quick writes 3-4). The 5 GB stop guards
# a guess that comes out low: one job killed with rc 28, never the disk.
measured_gb() {
  # a running warm job counts 10 too until 10 own rows exist (architect m_61208: at its flat 3, 4
  # cargo jobs got in at once on 11-11 and the disk fell to 11 GB free; a guess must err high)
  local flat; case "$1" in full|cargo-cold|cargo-warm) flat=10 ;; *) flat=2 ;; esac
  p90_gb "$1" 10 "$flat" 0 ""
}
# the cargo ceiling (architect m_61208): at most HEAVY_CARGO_MAX cargo jobs (full, cargo-warm,
# cargo-cold) run at once, max(1, cpus / 6) (2 on a 12-core Mac), whatever the load wait says:
# on 11-11 the 600 s load wait ran out and let 4 in at load 85. Desktop and other jobs are
# outside it; --prio (his release) and --alone too.
cargo_max() { local c; c=$(( $(/usr/sbin/sysctl -n hw.ncpu 2>/dev/null || echo 8) / 6 )); echo "${HEAVY_CARGO_MAX:-$(( c < 1 ? 1 : c ))}"; }
# the cargo jobs running now: the live reserve files of a cargo kind
cargo_running() {
  local f n=0
  for f in "$HOME/.bise/run/reserve/"*; do
    [ -e "$f" ] && kill -0 "${f##*.}" 2>/dev/null || continue
    case "$(rfield "$f" 5)" in full|cargo-warm|cargo-cold) n=$((n + 1)) ;; esac
  done
  echo "$n"
}
# the running jobs, for the queue's waiting line (main m_36953: 7 waiters
# waited 3-5 h behind a hung --alone job no line named): "<slot> <agent or
# folder> <N> min: <command>", '; ' between them
# a reserve file's field <n>, from its first line only: an older heavy-run
# wrote the command with its newlines (a node arg of JSON, release-53
# m_41368), and every reader then got several lines: heavy-run failed on
# 'n + 1 <json>' for every new job while that file was there
rfield() { head -1 "$1" 2>/dev/null | cut -f"$2"; }
# a whole number, or 0 (a broken field never reaches $(( )))
num() { case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }
holders() {
  local f p slot cwd who out=""
  for f in "$HOME/.bise/run/reserve/"*; do
    [ -e "$f" ] || continue
    p=${f##*.}; kill -0 "$p" 2>/dev/null || continue
    slot=${f##*/}; slot=${slot%.*}; slot=${slot%.lock}
    cwd=$(rfield "$f" 2); who=$(echo "$cwd" | sed -n 's#.*/worktrees/[^/]*/\([^/]*\)/.*#\1#p'); [ -n "$who" ] || who=${cwd##*/}
    out="$out${out:+; }$slot $who $(( ($(date +%s) - $(stat -f %m "$f")) / 60 )) min: $(rfield "$f" 4 | cut -c1-60)"
  done
  echo "$out"
}
# what the running jobs may still write, in GB. Each running job has
# ~/.bise/run/reserve/<slot>.<pid>: "<GB>\t<cwd>\t<free KB at its start>\t<command>\t<kind or ->"
# (gone at its end; a dead job's file is removed). The space the disk lost
# since the oldest of them started counts as written by them: their sum
# minus that drop, never under 0 (main m_36317: the whole sum, held to
# the end, kept jobs waiting at 32-34 GB free).
reserved_gb() {
  local f p n=0 top=0 k kb
  kb=$(free_kb); kb=${kb:-0}
  for f in "$HOME/.bise/run/reserve/"*; do
    [ -e "$f" ] || continue
    p=${f##*.}
    kill -0 "$p" 2>/dev/null || { rm -f "$f"; continue; }
    # its kind's measured share (field 5); a job that named its own
    # (HEAVY_RESERVE_GB: '-') or an older heavy-run's file: its reserve
    k=$(rfield "$f" 5)
    case "$k" in full|cargo-warm|cargo-cold|desktop|other) n=$(( n + $(measured_gb "$k") )) ;;
      *) n=$(( n + $(num "$(rfield "$f" 1)") )) ;; esac
    k=$(num "$(rfield "$f" 3)"); [ "$k" -gt "$top" ] && top=$k
  done
  [ "$top" -gt "$kb" ] && n=$(( n - (top - kb) / 1048576 ))
  [ "$n" -lt 0 ] && n=0
  # capped (main m_37136): the reserves guess what each job may still write,
  # and their whole sum kept every waiter out at 42 GB free; the 10 GB floor
  # and the stop under HEAVY_DISK_STOP_GB (5) still guard the disk. The
  # trade, main's: when several running jobs really write their whole
  # reserves at once, the disk can reach that stop and one job ends with
  # rc 28, where before a waiter waited. An rc 28 is that, not a bug of
  # the job: rerun it.
  [ "$n" -gt "${HEAVY_RESERVE_TOTAL_MAX:-20}" ] && n=${HEAVY_RESERVE_TOTAL_MAX:-20}
  echo "$n"
}
# the job's time limit in minutes, by kind (review-gates m_36096): about
# twice the longest run of each kind in heavy.log, 2026-10-14..21 (full
# gate 70 min, test:land 83, desktop_tag 104, the rest 41); 0: none.
# HEAVY_MAX_MIN wins.
max_min() {
  [ -n "${HEAVY_MAX_MIN:-}" ] && { echo "$HEAVY_MAX_MIN"; return; }
  case " $* " in
    *nightly_gate.sh*) echo 360 ;;
    # any other --alone job holds every slot: the rest's limit (main m_36953:
    # a cost measure held the 4 slots 6.5 h on 2026-10-21, 3 h of it hung)
    *" --alone "*) echo 120 ;;
    *desktop_tag*|*desktop-release*) echo 240 ;;
    *test:land*) echo 180 ;;
    *"gate.sh full"*|*"gate.sh rerun"*) echo 150 ;;
    *) echo 120 ;;
  esac
}
# the 1-minute load average, an integer (HEAVY_LOAD_FILE: tests)
load1() {
  if [ -n "${HEAVY_LOAD_FILE:-}" ]; then cat "$HEAVY_LOAD_FILE" 2>/dev/null; return; fi
  /usr/sbin/sysctl -n vm.loadavg 2>/dev/null | awk '{print int($2)}'
}
# the admission's facts, one line 'quiet=<what|-> cpu=<%> agents=<n> low=<n>': disk_reclaim.py
# --admit beside this file (one ps snapshot, the quiet locks, the reserve files);
# HEAVY_ADMIT_FILE (tests): that file's line instead. None (it failed): no quiet, no CPU read
admit_facts() {
  if [ -n "${HEAVY_ADMIT_FILE:-}" ]; then cat "$HEAVY_ADMIT_FILE" 2>/dev/null; return; fi
  /usr/bin/python3 "$(cd "$(dirname "$0")" && pwd)/disk_reclaim.py" --admit 2>/dev/null
}
# a field of that line: fact <name> <line>
fact() { echo "$2" | tr ' ' '\n' | sed -n "s/^$1=//p"; }
# whether a release-lane job (heavy5.lock) ran at any time from epoch $1 to
# now, read from heavy.log ($2): an --alone job's end line says so
# ('lane=busy'), since --alone never takes the lane (review-gates m_35984):
# a timing red in a night with it may come from the lane's load
lane_during() {
  awk -F'\t' -v t0="$1" -v now="$(date +%s)" '
    $4 != "heavy5.lock" && $4 != "heavy6.lock" { next }
    $3 == "-" { open[$1 FS $2] = $2; next }
    { delete open[$1 FS $2]; if ($2 <= now && $3 >= t0) busy = 1 }
    END { for (k in open) if (open[k] <= now) busy = 1; if (busy) print "busy" }' "$2" 2>/dev/null
}
# the running jobs (this one too, while its reserve file is there), each
# "<slot>.<pid> <kind or -> <GB counted for it>", '; ' between them
shares() {
  local f kd g out=""
  for f in "$HOME/.bise/run/reserve/"*; do
    [ -e "$f" ] || continue; kill -0 "${f##*.}" 2>/dev/null || continue
    kd=$(rfield "$f" 5); case "$kd" in full|cargo-warm|cargo-cold|desktop|other) g=$(measured_gb "$kd") ;; *) g=$(num "$(rfield "$f" 1)") ;; esac
    out="$out${out:+; }${f##*/} ${kd:--} $g"
  done
  echo "$out"
}
# the KB the disk reclaims freed from epoch $1 to $2 (reclaim.log: <epoch>
# <path> <idle min> <GB freed> <reason>)
reclaimed_kb() {
  awk -F'\t' -v t0="$1" -v t1="$2" '$1 >= t0 && $1 <= t1 && $4 ~ /^[0-9.]+$/ { s += $4 } END { printf "%d\n", s * 1048576 }' \
    "$HOME/.bise/run/reclaim.log" 2>/dev/null || echo 0
}
export -f gate_kind kind_dirs free_kb disk_under free_gb tell_hub tree reclaim cpu_cs disk_watch lane_during p90_gb measured_gb reclaimed_kb shares rfield num

# HEAVY_SLOTS (tests): use only the first n slots, whatever the power.
# HEAVY_ON_BATTERY=0|1 (tests): the power as given, not pmset's
# the battery's charge in % (HEAVY_BATTERY_PCT: tests); 100 when unknown
battery_pct() {
  [ -n "${HEAVY_BATTERY_PCT:-}" ] && { echo "$HEAVY_BATTERY_PCT"; return; }
  /usr/bin/pmset -g batt 2>/dev/null | grep -oE '[0-9]+%' | head -1 | tr -d % | grep . || echo 100
}
on_battery() {
  [ -n "${HEAVY_ON_BATTERY:-}" ] && { [ "$HEAVY_ON_BATTERY" = 1 ]; return; }
  /usr/bin/pmset -g batt 2>/dev/null | head -1 | grep -q "Battery Power"
}
# sccache (build-cache, 2026-10-10): rustc outputs shared across worktrees
# through a disk cache (~/.cache/sccache, 8G cap: the disk is tight). Never a
# shared target dir. One sccache server per worktree (its own socket), started
# with SCCACHE_BASEDIRS = that worktree's root, so paths inside the worktree
# hash the same in every worktree. Incremental is left on: sccache skips the
# workspace crates cargo builds incrementally (dev profile) and caches the
# dependencies, the bulk of a cold build. Off: HEAVY_NO_SCCACHE=1, or a
# RUSTC_WRAPPER already set by the caller, or a caller with a file size limit
# (an agent's bash tool: 50 MB): the server it would start keeps that limit
# and every later compile of that worktree would die of SIGXFSZ.
# Measured (cargo build -p switchboard, fresh target): 95 s plain, 122 s
# cold cache, 64 s warm cache from another worktree (86 % hits).
# OFF by default since 2026-10-12 (loop-speed-4), opt in with HEAVY_SCCACHE=1:
# measured on the live servers 0 hits of 66 compiles (41 + 25), and it made
# gates red for nothing: (1) a worktree's server outlives the gate run that
# started it and keeps that run's TMPDIR (~/.bise/gate/<pid>, deleted at its
# end): the next gate's compiles die "Failed to create temp dir"; (2) inside
# the approvals sandbox test, sccache's socket path from the box's long
# TMPDIR is over macOS's 104 bytes (SUN_LEN, core-b). The seed clone
# (gate.sh) already shares the deps between task targets for 0 bytes.
SCC=/opt/homebrew/bin/sccache
if [ -n "${HEAVY_SCCACHE:-}" ] && [ -z "${HEAVY_NO_SCCACHE:-}" ] && [ -z "${RUSTC_WRAPPER:-}" ] && [ -x "$SCC" ] \
   && [ "$(ulimit -f)" = unlimited ]; then
  export RUSTC_WRAPPER="$SCC" SCCACHE_DIR="$HOME/.cache/sccache" SCCACHE_CACHE_SIZE=8G
  if root=$(git rev-parse --show-toplevel 2>/dev/null); then
    mkdir -p "$HOME/.cache/sccache-srv"
    h=$(printf %s "$root" | /usr/bin/shasum | cut -c1-12)
    export SCCACHE_BASEDIRS="$root" SCCACHE_SERVER_UDS="$HOME/.cache/sccache-srv/$h.sock"
  fi
fi

# cargo parallelism (main, 2026-10-10): two jobs at cargo's default (12
# rustc each on this 12-core Mac) put the load at 35 and starved agents'
# REPL starts for 1007 s (amb-web, ambient-pm, launch crashed). Each job
# gets 5 jobs by default, so two jobs leave cores for the hub, the REPLs
# and the user. A caller's CARGO_BUILD_JOBS wins; --alone keeps the default.
# With 4 slots on AC: 4 jobs each, so 4 cargo builds stay at 16 rustc.
[ -z "${CARGO_BUILD_JOBS:-}" ] && export CARGO_BUILD_JOBS=4


ALONE=0; PRIO=0; LOW=0; LAND=0
while :; do
  case "${1:-}" in
    --alone) ALONE=1; shift ;;
    --land) LAND=1; shift ;;
    --low) LOW=1; shift ;;
    --prio) PRIO=1; shift ;;
    *) break ;;
  esac
done

# the light lane (fast-loop, main's audit m_36983: a quick gate waited p50 409 s
# for a slot and the disk reserve, its own run 32-41 s of python checks): a
# command that is only a quick gate (`tests/gate.sh quick`, maybe after `bash` or in `bash -c`
# with its output piped to tail/grep/head/tee) whose tree runs no heavy step
# (`gate.sh light`: no cargo, PROOF, desktop, office or proto step) runs now,
# with no slot, no disk reserve and no load wait; heavy.log gets its lines
# with the slot 'light'. Anything else, or a light check that fails, queues as
# before. HEAVY_NO_LIGHT=1: never.
light_gate() {
  local s="$*" re='^((bash|sh)( -c)? )?([^ ;&|]*gate\.sh) quick( *2>&1)?( *\| *(tail|grep|head|tee)[^;&]*)*$'
  [ "$ALONE" = 0 ] && [ -z "${HEAVY_NO_LIGHT:-}" ] && [[ "$s" =~ $re ]] || return 1
  local gs="${BASH_REMATCH[4]}"
  [ -f "$gs" ] && bash "$gs" light >/dev/null 2>&1
}
# At most HEAVY_LIGHT_MAX (4) light runs at once, each holding one of
# light<N>.lock (review-gates m_37126: 6 agents out of the disk wait at once
# spawn ~300 processes/s, and the Mac's audit daemon melts at that); the next
# one waits a moment. The run carries HEAVY_SLOT='light <pid>': gate.sh quick
# then refuses any heavy step (a tree that changed after the light check),
# and a nested heavy-run is refused as in a slot.
LJOB='m="$1"; shift; : >"$m"; export HEAVY_SLOT="light $$"; nice -n 10 "$@"'
if light_gate "$@"; then
  echo "heavy-run: a light quick gate (no cargo, PROOF, desktop or office step): it runs now, no slot" >&2
  L="$D/heavy.log" c=$(printf "%s " "$@" | cut -c1-160) sub=$(date +%s) mk="$D/light-started.$$" said=""
  printf "%s\t%s\t-\tlight\t%s\t%s\n" "$sub" "$sub" "$PWD" "$c" >>"$L" 2>/dev/null
  while :; do
    for i in $(seq 1 "${HEAVY_LIGHT_MAX:-4}"); do
      rm -f "$mk"
      /usr/bin/lockf -k -t 0 "$D/light$i.lock" /bin/bash -c "$LJOB" _ "$mk" "$@" 2>/dev/null; rc=$?
      # 75 and no mark: that lock was taken (lockf's own word), the job never started
      if [ "$rc" != 75 ] || [ -e "$mk" ]; then
        rm -f "$mk"
        printf "%s\t%s\t%s\tlight\t%s\t%s\trc=%s\n" "$sub" "$sub" "$(date +%s)" "$PWD" "$c" "$rc" >>"$L" 2>/dev/null
        return $rc
      fi
    done
    [ -n "$said" ] || { echo "heavy-run: ${HEAVY_LIGHT_MAX:-4} light quick gates run already: waiting for one to end" >&2; said=1; }
    sleep 1
  done
fi

# the CPU (mac-budget, 2026-10-21): a slot gets HEAVY_THREADS (4) threads, so
# 5 busy slots fit about 2 x the 12 cores. cargo builds were capped already
# (CARGO_BUILD_JOBS above); each cargo test binary ran 12 test threads and a
# gate 4 e2e hubs at once: RUST_TEST_THREADS=4 and SB_TEST_JOBS=2 in a slot.
# A caller's value wins; an --alone job has the machine, it keeps them.
if [ "$ALONE" = 0 ]; then
  export RUST_TEST_THREADS="${RUST_TEST_THREADS:-${HEAVY_THREADS:-4}}"
  export SB_TEST_JOBS="${SB_TEST_JOBS:-$(( (${HEAVY_THREADS:-4} + 1) / 2 ))}"
fi
# the job's disk reserve (reserve_gb) and its time limit in minutes (max_min)
# HEAVY_KIND: decided once, here; the job's disk.tsv line carries this same
# key, so what it wrote feeds the reserve of the jobs of its kind
export HEAVY_KIND; HEAVY_KIND=$(job_kind "$([ "$ALONE" = 1 ] && echo --alone)" "$@")
export HEAVY_RESERVE; HEAVY_RESERVE=$(reserve_gb "$HEAVY_KIND")
export HEAVY_MAX; HEAVY_MAX=$(max_min "$([ "$ALONE" = 1 ] && echo --alone)" "$@")

# The watcher runs with fds 3-9 closed: its sleep outlives a kill of the
# watcher by up to HEAVY_DISK_POLL s and held the slot's lock (lockf's fd)
# that long after the job ended (a --prio job found the lane busy, 10-21).
# the job, in its slot: $1 its ticket (gone once it runs), $2 the slot, $3
# the nice level, then the command. HEAVY_SLOT="<slot> <pid of this shell>".
export HEAVY_SUBMIT="${HEAVY_SUBMIT:-$(date +%s)}"
JOB='export HEAVY_SLOT="${2##*/} $$"; rm -f "$1"; L="$HOME/.bise/run/heavy.log"
c=$(printf "%s " "${@:4}" | tr "\n\t\r" "   " | cut -c1-160); t0=$(date +%s)
printf "%s\t%s\t-\t%s\t%s\t%s\twaited=%s%s\n" "$HEAVY_SUBMIT" "$t0" "${2##*/}" "$PWD" "$c" "${HEAVY_WAITED:-}" "${HEAVY_NOTE:+	$HEAVY_NOTE}" >>"$L" 2>/dev/null
touch "$HOME/.bise/run/last-start"
rv="$HOME/.bise/run/reserve/${2##*/}.$$"; mkdir -p "${rv%/*}"; k0=$(free_kb)
others=$(ls "${rv%/*}" 2>/dev/null | grep -vc "^${rv##*/}\$")
export HEAVY_CPUS=$(( $(/usr/sbin/sysctl -n hw.ncpu 2>/dev/null || echo 8) / (others + 1) ))
printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$HEAVY_RESERVE" "$PWD" "$k0" "$c" "$([ -n "${HEAVY_RESERVE_GB:-}" ] && echo - || echo "$HEAVY_KIND")" "${HEAVY_RANK:-2}" >"$rv"
mnf="$HOME/.bise/run/disk-min.$$"; echo "$k0" >"$mnf"
r=$(git rev-parse --show-toplevel 2>/dev/null) || r=$PWD
for f in "$r"/target/RECLAIMED.txt "$r"/*/target/RECLAIMED.txt "$r"/*/*/target/RECLAIMED.txt; do
  [ -e "$f" ] && { echo "$(cat "$f") (${f%/RECLAIMED.txt})" >&2; rm -f "$f"; }
done
reclaim 0
stop="$HOME/.bise/run/disk-stop.$$"; rm -f "$stop"
idle=0; [ "$2" = all ] && idle="${HEAVY_IDLE_MIN:-30}"
disk_watch $$ "$stop" "$HEAVY_MAX" "$idle" "$mnf" </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- & w=$!
/usr/bin/caffeinate -is nice -n "$3" "${@:4}"; rc=$?
kill $w 2>/dev/null; wait $w 2>/dev/null
sh=""; [ -e "$stop" ] && sh=$(shares)
rm -f "$rv"
# what it wrote, for the next reserve of its kind (reserve_gb): the free KB
# at its start minus the lowest the watcher saw, or at its start minus at its
# end plus what reclaims freed meanwhile (the GB in reclaim.log from its
# start to its end; review-gates m_37481: before, the long jobs overlapped a
# reclaim and logged a dash, so the measure saw the short ones only), the larger,
# never under 0; the jobs running beside it write meanwhile too: an upper
# bound. A reclaim still running at its end has not logged what it freed:
# written is "-", which reserve_gb skips.
# ~/.bise/run/disk.tsv: <end> <kind> <written KB> <free KB at start> <lowest> <others> <command>
k1=$(free_kb); mn=$(cat "$mnf" 2>/dev/null); rm -f "$mnf"
[ -n "$k1" ] && { [ -z "$mn" ] || [ "$k1" -lt "$mn" ]; } && mn=$k1
if [ -n "$k0" ] && [ -n "$mn" ]; then
  fr=$(reclaimed_kb "$t0" "$(date +%s)")
  wr=$(( k0 - mn )); w2=$(( k0 - ${k1:-$k0} + ${fr:-0} )); [ "$w2" -gt "$wr" ] && wr=$w2; [ "$wr" -lt 0 ] && wr=0
  [ -e "$HOME/.bise/run/reclaim.running" ] && wr=-
  # a kind with its own dirs (kind_dirs): what the job grew them by (disk_reclaim.py --grown,
  # architect m_60754, m_60879), walked once its rc is known, in the background with fds closed
  # (never on the slot or on the exit of the job), its row src=own; the free-drop row below for
  # a kind with none
  kd=$(kind_dirs "$HEAVY_KIND")
  if [ -n "$kd" ]; then
    # shellcheck disable=SC2086  # the dirs, one word each
    ( g=$(${HEAVY_RECLAIM:-/usr/bin/python3 $HOME/.bise/run/disk_reclaim.py} --grown "$t0" "$PWD" $kd 2>/dev/null) && [ -n "$g" ] &&
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\tsrc=own
" "$(date +%s)" "$HEAVY_KIND" "$g" "$k0" "$mn" "$others" "$c" >>"$HOME/.bise/run/disk.tsv" ) </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
  fi
  [ -n "$kd" ] ||
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$(date +%s)" "$HEAVY_KIND" "$wr" "$k0" "$mn" "$others" "$c" >>"$HOME/.bise/run/disk.tsv" 2>/dev/null
fi
if [ -e "$stop" ]; then
  why=$(cat "$stop")
  case "$why" in
    time*) m="heavy-run: stopped \"$c\": it ran ${why#time } min, over its limit (HEAVY_MAX_MIN=${why#time }): a stuck job holds a slot (2 held 12.7 h on 2026-10-20). Find why it hangs, or give it a larger HEAVY_MAX_MIN."; rc=124 ;;
    idle*) m="heavy-run: stopped \"$c\": an --alone job (it holds every slot) used no CPU for ${why#idle } min: it hangs. Find why, or give it a larger HEAVY_IDLE_MIN."; rc=124 ;;
    *) m="heavy-run: stopped \"$c\": the disk is nearly full (${why#disk } GB free on the data volume, under ${HEAVY_DISK_STOP_GB:-5} GB). Free some space, then run it again."; rc=28
       # one line for the audit (review-gates m_37481: two in a day put the floor back to 15):
       # <epoch> disk-stop <slot> <free GB> <each running job: slot kind counted GB> <command>
       printf "%s\tdisk-stop\t%s\t%s\t%s\t%s\n" "$(date +%s)" "${2##*/}" "${why#disk }" "${sh:-none}" "$c" >>"$L" 2>/dev/null ;;
  esac
  echo "$m" >&2; tell_hub "$m"; rm -f "$stop"
fi
lane=""; [ "$2" = all ] && [ "$(lane_during "$t0" "$L")" = busy ] && lane="	lane=busy"
printf "%s\t%s\t%s\t%s\t%s\t%s\trc=%s%s\n" "$HEAVY_SUBMIT" "$t0" "$(date +%s)" "${2##*/}" "$PWD" "$c" "$rc" "$lane" >>"$L" 2>/dev/null
exit $rc'

# a full gate (tests/gate.sh full) runs one at a time on the machine (its own
# lock, ~/.bise/gate/full-<uid>.lock): while another one holds that lock, a
# full gate waits here, before it takes a slot, instead of holding a slot
# idle for 7-10 min (loop-speed-4, 2026-10-12: release-29 held one 637 s).
GLOCK="$HOME/.bise/gate/full-$(id -u).lock"
case " $* " in
  *"gate.sh full"*)
    said=""
    while o=$(cat "$GLOCK/owner" 2>/dev/null) && [ -n "$o" ] && kill -0 "${o%% *}" 2>/dev/null; do
      [ -n "$said" ] || { echo "heavy-run: waiting for the full gate of ${o#* * } before taking a slot"; said=1; }
      sleep 5
    done ;;
esac

# the rank: what the job is (review-gates m_35387), --alone or not
rank=2
case " $* " in *"gate.sh full"*|*"gate.sh rerun"*|*"test:land"*|*"nightly_gate.sh"*) rank=1 ;; esac
[ "$LAND" = 1 ] && rank=1
[ "$LOW" = 1 ] && rank=3
[ "$PRIO" = 1 ] && rank=0
export HEAVY_RANK=$rank
[ "$ALONE" = 1 ] && while on_battery; do sleep 60; done
T="$Q/$rank-$HEAVY_SUBMIT-$$"
# the ticket holds its own time (a reused pid started after it is no
# waiter) and "alone" for an --alone job. A waiting --alone job holds no
# slot: it starts when the 4 are free at once. For its first
# HEAVY_ALONE_DRAIN_MIN (10) min the jobs behind it still start in free
# slots; past that, they wait behind it, so the slots drain and it gets them
# all (main m_37006: holding each slot as it freed, an --alone job kept the
# queue idle 3.5 h on 2026-10-21)
echo "$(date +%s)$([ "$ALONE" = 1 ] && echo ' alone')" >"$T"
trap 'rm -f "$T"' EXIT
# the live tickets ahead of this one, 99 behind a waiting --alone; a dead
# waiter's ticket (its pid gone, or reused by a younger process) is removed.
# One ps for every ticket, only when a slot is free.
ahead() {
  local list pids
  list=$(ls "$Q" 2>/dev/null | sort -t- -k1,1n -k2,2n -k3,3n)
  [ -n "$list" ] || { echo 0; return; }
  # ps refuses the whole list for one pid out of range: those are dead anyway
  pids=$(printf '%s\n' $list | sed 's/.*-//' | awk '$1 ~ /^[0-9]+$/ && $1 > 0 && $1 < 100000' | paste -sd, -)
  { [ -n "$pids" ] && ps -o pid=,etime= -p "$pids" 2>/dev/null | sed 's/^ */P /'
    for f in $list; do echo "T $f $(head -c 40 "$Q/$f" 2>/dev/null)"; done; } |
  awk -v now="$(date +%s)" -v me="${T##*/}" -v drain="$(( ${HEAVY_ALONE_DRAIN_MIN:-10} * 60 ))" '
    $1 == "P" { k = split($3, a, /[-:]/)
                age[$2] = k == 4 ? a[1]*86400 + a[2]*3600 + a[3]*60 + a[4] : (k == 3 ? a[1]*3600 + a[2]*60 + a[3] : a[1]*60 + a[2]); next }
    $1 == "T" { pid = $2; sub(/.*-/, "", pid); made = $3 + 0
                # a young --alone waiter holds nobody back yet (draining after drain s)
                if ($4 == "alone" && $2 != me && now - made < drain && (pid in age) && !(made > 0 && age[pid] < now - made - 2)) next
                if (!(pid in age) || (made > 0 && age[pid] < now - made - 2)) { print "rm", $2; next }
                if ($2 == me) { mine = 1; next }
                if (!mine) { n++; if ($4 == "alone") held = 1 } }
    END { print "n", held ? 99 : n + 0 }' |
  while read -r k v; do if [ "$k" = rm ]; then rm -f "$Q/$v"; else echo "$v"; fi; done
}

# what the job waited on before its start, in seconds (review-gates m_37641: boot-photo's 38 min
# from submit to start could not be read): each round's time goes to the reason the round before
# ended on (disk, battery, load, else a slot); tally adds it, and HEAVY_WAITED carries
# "disk:<s> slot:<s> load:<s> batt:<s>" to the job's start line in heavy.log (waited=...)
# HEAVY_DEADLINE must be an epoch: 'HH:MM' would make its -ge never fire, silently
case "${HEAVY_DEADLINE:-}" in *[!0-9]*) echo "heavy-run: HEAVY_DEADLINE wants an epoch (seconds), got '$HEAVY_DEADLINE'" >&2; exit 2 ;; esac
# the own-cap (fast-loop, architect m_59130; main m_59126): before the job waits for disk or a
# slot, its own agent dir's cargo targets over HEAVY_OWN_CAP_GB of their own bytes are trimmed,
# no idle time or green gate needed: nothing builds there until this job does. The rule is
# disk_reclaim.py's (--own); here only the call. Never fails the job: its lines go to stderr.
own_cap() {
  local r="${HEAVY_RECLAIM:-/usr/bin/python3 $HOME/.bise/run/disk_reclaim.py}"
  $r --own "$PWD" </dev/null 2>&1 | sed 's/^/heavy-run: /' >&2
  return 0
}
own_cap
wd=0 ws=0 wl=0 wb=0 wq=0 why="" prev=$(date +%s)
tally() {
  local now; now=$(date +%s)
  case "$why" in disk) wd=$((wd + now - prev)) ;; slot) ws=$((ws + now - prev)) ;; load) wl=$((wl + now - prev)) ;; batt) wb=$((wb + now - prev)) ;; quiet) wq=$((wq + now - prev)) ;; esac
  prev=$now; why=""
  export HEAVY_WAITED="disk:$wd slot:$ws load:$wl batt:$wb quiet:$wq"
}
# lockf -t 0 exits 75 (EX_TEMPFAIL) when the slot is taken.
while :; do
  tally
  # HEAVY_DEADLINE (an epoch: the nightly's end, review-gates m_38056): a job still queued then
  # never starts. On 2026-10-23 the night queued at 01:43 still waited at 09:31, and its --alone
  # would have taken the 4 slots for hours in the day. It exits 75 with who held the slots.
  if [ -n "${HEAVY_DEADLINE:-}" ] && [ "$(date +%s)" -ge "$HEAVY_DEADLINE" ] 2>/dev/null; then
    h=$(holders)
    echo "heavy-run: no slot by $(date -r "$HEAVY_DEADLINE" +%H:%M): ${h:-the slots were held (no holder left)}" >&2
    exit 75
  fi
  held=""
  # the disk: the floor (HEAVY_DISK_WAIT_GB, 10; 15 before 2026-10-22, main m_37463) + what the running jobs may
  # still write + this job's own reserve must be free; else reclaim, and wait
  need=$(( ${HEAVY_DISK_WAIT_GB:-10} + HEAVY_RESERVE + $(reserved_gb) ))
  if disk_under "$need"; then
    reclaim "$need"
    if [ -z "${diskwait:-}" ]; then
      m="heavy-run: waiting for disk room: $(free_gb) GB free, this job starts at $need GB (${HEAVY_DISK_WAIT_GB:-10} kept free + $HEAVY_RESERVE it may write + $(( need - ${HEAVY_DISK_WAIT_GB:-10} - HEAVY_RESERVE )) the running jobs may still write); reclaiming idle cargo targets: $(printf '%s ' "$@" | cut -c1-80)"
      echo "$m" >&2; tell_hub "$m"; diskwait=1
    fi
    why=disk; sleep "${HEAVY_DISK_POLL:-10}"; continue
  fi
  if [ -n "${diskwait:-}" ]; then
    m="heavy-run: disk room again ($(free_gb) GB free), the job goes on: $(printf '%s ' "$@" | cut -c1-80)"
    echo "$m" >&2; tell_hub "$m"; diskwait=""
  fi
  # the battery (mac-budget): on battery under HEAVY_BATTERY_MIN (30) %, no
  # job starts. On 2026-10-20 the Mac ran its jobs on battery to 1 %, slept
  # at 21:43 and hibernated to 10:20: no night, no nightly, main hung 11 h.
  if on_battery && [ "$(battery_pct)" -lt "${HEAVY_BATTERY_MIN:-30}" ] 2>/dev/null; then
    [ -n "${battwait:-}" ] || { m="heavy-run: waiting: on battery at $(battery_pct) %, under ${HEAVY_BATTERY_MIN:-30} %: plug the Mac in: $(printf '%s ' "$@" | cut -c1-80)"; echo "$m" >&2; tell_hub "$m"; battwait=1; }
    why=batt; sleep "${HEAVY_DISK_POLL:-10}"; continue
  fi
  battwait=""
  if on_battery; then n=15; slots="$S1 $S2"; else n=10; slots="$S1 $S2 $S3 $S4"; fi
  if [ -n "${HEAVY_SLOTS:-}" ]; then slots=$(echo "$S1 $S2 $S3 $S4" | cut -d' ' -f1-"$HEAVY_SLOTS"); fi
  # the release lane: --prio alone, first (HEAVY_NO_LANE=1: none, tests)
  [ "$PRIO" = 1 ] && [ -z "${HEAVY_NO_LANE:-}" ] && slots="$S5 $slots"
  # a release pass's lane: slot 6 too (the header's slot 6)
  [ "$PRIO" = 1 ] && [ -n "$PASS_LANE" ] && [ -z "${HEAVY_NO_LANE:-}" ] && slots="$S5 $S6 ${slots#"$S5 "}"
  if [ "$ALONE" = 1 ]; then
    # its turn (nobody ahead): the 4 slots at once when all are free, never
    # one by one (a slot it took waited idle for the others); lockf -t 0 each:
    # one taken meanwhile exits 75 before the job, its ticket still here: retry
    if [ "$(ahead)" = 0 ]; then
      free=0
      for s in "$S1" "$S2" "$S3" "$S4"; do /usr/bin/lockf -k -t 0 "$s" /usr/bin/true 2>/dev/null && free=$((free + 1)); done
      if [ "$free" = 4 ]; then
        why=slot; tally
        /usr/bin/lockf -k -t 0 "$S1" /usr/bin/lockf -k -t 0 "$S2" /usr/bin/lockf -k -t 0 "$S3" /usr/bin/lockf -k -t 0 "$S4" \
          /bin/bash -c "$JOB" _ "$T" "all" 10 "$@"
        rc=$?
        { [ "$rc" != 75 ] || [ ! -e "$T" ]; } && exit "$rc"
      fi
    fi
  else
    # probe the slots quietly first: a taken slot makes lockf print
    # 'already locked' on every try, which buried a job's real last lines.
    free=""
    for s in $slots; do /usr/bin/lockf -k -t 0 "$s" /usr/bin/true 2>/dev/null && free="$free $s"; done
    # the cargo ceiling (cargo_max): a cargo job waits while that many run, the load wait or not
    if [ -n "$free" ] && [ "$PRIO" = 0 ] && case "$HEAVY_KIND" in full|cargo-warm|cargo-cold) true ;; *) false ;; esac \
       && [ "$(cargo_running)" -ge "$(cargo_max)" ]; then
      held=1; free=""
      [ -n "${cargowait:-}" ] || { echo "heavy-run: a slot is free but $(cargo_max) cargo jobs run already (HEAVY_CARGO_MAX), waiting" >&2; cargowait=1; }
    fi
    # a release pass's lane waits while the other lane runs a timing-bound step (pass-timing.lock
    # held, its marker '<lane> <what> since ...'); its own lane's window never holds it
    if [ -n "$free" ] && [ -n "$PASS_LANE" ] && ! /usr/bin/lockf -k -t 0 "$D/quiet/pass-timing.lock" /usr/bin/true 2>/dev/null; then
      pl=$(cut -d' ' -f1-2 "$D/quiet/pass-timing.lock" 2>/dev/null)
      if [ -n "$pl" ] && [ "${pl%% *}" != "$PASS_LANE" ]; then
        held=quiet; free=""
        [ "${loadwait:-}" = pass ] || { echo "heavy-run: lane $PASS_LANE waits: lane ${pl%% *} runs a timing-bound step (${pl#* })" >&2; loadwait=pass; }
      fi
    fi
    # the admission (fast-loop, main m_63076 m_63082, architect m_63083 m_63085 m_63105; the
    # header's (1)-(4)). --prio (the release lane) is exempt from all of it.
    if [ -n "$free" ] && [ "$PRIO" = 0 ]; then
      ceil="${HEAVY_LOAD_CEILING:-$(( 2 * $(/usr/sbin/sysctl -n hw.ncpu 2>/dev/null || echo 8) ))}"
      bar="${HEAVY_JOBS_CPU:-$(( 75 * $(/usr/sbin/sysctl -n hw.ncpu 2>/dev/null || echo 8) ))}"
      facts=$(admit_facts); qw=$(fact quiet "$facts"); jc=$(num "$(fact cpu "$facts")")
      na=$(num "$(fact agents "$facts")"); nl=$(num "$(fact low "$facts")"); ld=$(num "$(load1)")
      ls_=$(stat -f %m "$D/last-start" 2>/dev/null || echo 0)
      floor=""
      if [ -n "$facts" ]; then
        { [ "$rank" = 3 ] && [ "$nl" = 0 ] && [ "$na" -lt 2 ]; } || { [ "$rank" != 3 ] && [ "$na" = 0 ]; } && floor=1
      fi
      hold="" over=""
      if [ -n "$qw" ] && [ "$qw" != - ]; then
        hold=quiet; msg="the release runs a timing-bound step ($qw): its quiet window"
      elif [ "$ld" -ge "$ceil" ]; then
        # over the ceiling: a lane's floor still goes when the load isn't ours (our jobs under
        # half the bar); a runaway of ours holds everyone
        if [ -n "$floor" ] && [ $(( jc * 2 )) -lt "$bar" ]; then over="admitted over ceiling, load $ld, ours ${jc}%"
        else hold=load; msg="the machine is busy (load $ld, the ceiling $ceil; ours ${jc}%)"; fi
      elif [ -n "$floor" ]; then
        :  # the lane's floor: its first job goes
      elif [ "$jc" -ge "$bar" ]; then
        hold=load; msg="our running jobs use ${jc}% CPU, the bar $bar%"
      elif [ $(( $(date +%s) - ls_ )) -lt "${HEAVY_START_GAP:-20}" ]; then
        hold=load; msg="a job started under ${HEAVY_START_GAP:-20} s ago"
      fi
      export HEAVY_NOTE="$over"
      if [ -n "$hold" ]; then
        held=$hold; free=""
        [ "${loadwait:-}" = "$hold" ] || { echo "heavy-run: a slot is free but $msg: waiting" >&2; loadwait=$hold; }
      elif [ -n "$over" ]; then
        echo "heavy-run: $over (its lane runs nothing, the load isn't ours)" >&2
      fi
    fi
    if [ -n "$free" ] && [ "$(ahead)" -lt "$(echo $free | wc -w)" ]; then
      why=slot; tally
      for s in $free; do
        /usr/bin/lockf -k -t 0 "$s" /bin/bash -c "$JOB" _ "$T" "$s" "$n" "$@"
        rc=$?
        [ "$rc" -ne 75 ] && exit "$rc"
      done
    fi
  fi
  [ -n "${waited:-}" ] || { h=$(holders); echo "heavy-run: every heavy slot is busy or promised to an earlier job, waiting (rank $rank)${h:+; held by: $h}" >&2; waited=1; }
  # held by the load: poll every 5 s, not 2 (each round spawns ~10
  # processes per waiter: 6 waiters made ~45 spawns/s at load 120)
  if [ "$held" = quiet ]; then why=quiet; sleep 5; elif [ -n "$held" ]; then why=load; sleep 5; else why=slot; sleep 2; fi
done
}
heavy_run "$@"; exit $?
