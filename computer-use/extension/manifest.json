{
  "manifest_version": 3,
  "name": "bise computer use",
  "version": "0.1.0",
  "description": "Lets your bise agents use the web in their own tab groups, in the background.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "nativeMessaging",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  }
}
