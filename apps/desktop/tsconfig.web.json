{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "//": "kit/view/code.ts: the one code table the Code app's view reads too (code-view, architect m_66499); rootDir reaches it (nothing is emitted: noEmit)",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/ds/purity.mts", "tests/feature/**/*.ts", "tests/nightly/*.ts", "../../kit/view/code.ts"],
  "exclude": ["src/main/**"]
}
