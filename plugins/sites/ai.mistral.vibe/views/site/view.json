{
  "schemaVersion": 1,
  "name": "site",
  "description": "Open a web page or a site folder: the site runs on its own origin with its own storage, its links move inside it, and he notes on its blocks. Opened by a click on the file; not for the agent to call.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "file": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "resourceUri": { "type": "string" } },
        "required": ["name", "resourceUri"]
      }
    },
    "required": ["file"]
  },
  "ui": {
    "csp": { "connectDomains": [], "resourceDomains": ["https://fonts.googleapis.com", "https://fonts.gstatic.com"], "frameDomains": [], "baseUriDomains": [] },
    "permissions": {}
  },
  "_meta": {
    "ai.mistral.vibe/ui": {
      "entrypoints": [
        { "type": "file", "extensions": [".html", ".htm"], "title": "Sites" }
      ]
    },
    "dev.bise/ui": {
      "isolate": "document",
      "files": [
        { "match": ["*.html", "*.htm"], "title": "Web page", "rank": "owner" },
        { "match": ["*/index.html"], "folder": true, "title": "Website", "rank": "owner" }
      ]
    }
  }
}
