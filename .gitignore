# Build artifacts (Bend native binaries), never committed (BISE-114):
# scripts/bins.sh builds them from a cache keyed by the content of their sources
# (run.sh, versions.sh, gate.sh call it). A binary the EDR quarantined:
# scripts/bins.sh <name> puts it back.
# harness-demo: bend/runtime/demo.bend (bend-harness-qa skill); repl: legacy name
/repl-live
/repl-scripted
/sb-core
/bend-jsrt
harness-demo
repl

# Rust build output
target/

# this checkout's own dev flow (`/flow`, `sb flow` write it: trunk or PR,
# per user and per clone, never shared through the repo)
/.switchboard/

# the archived ambient agent's mockups, spec, sounds and paintings (Oct
# 2-7): kept on disk on purpose, out of the public repo
/site/content/ambient/

# Logs
logs/

# Sheets' xlsx grid (Univer, ~7 MB): built by scripts/bins.sh office-sheet from
# plugins/sheets/src with office/sdk's lockfile, never committed (architect m_37322, m_60401)
/plugins/sheets/ai.mistral.vibe/views/grid/office-sheet.js
/plugins/sheets/ai.mistral.vibe/views/grid/office-sheet.js.key

# Dependencies
node_modules/

# OS / editor
.DS_Store
*.pyc
__pycache__/

# the old release.sh bundle (gone, BISE-164: packaging/build-dist.sh
# makes the tarball, in /tmp/bise-dist)
dist/
# the office SDK's bundle is committed (docs/office.md: cargo and nix never run pnpm)
!/office/dist/

